export const meta = {
  name: 'kezjegy-k6-5-funkcio',
  description: 'Five new client features for the accountant app (owner 11-19 "mind az 5 kell"): tax-reserve per invoice, new-invoice notification, 2026 personal tax allowances, net income view, change guides with real NAV screens; research + spec now, build after the running k5 job (args.epit)',
  phases: [
    { title: 'Kutatás', detail: '2026 SZJA/járulék allowances for átalányadós EV, from official sources' },
    { title: 'Terv', detail: 'SPEC §28 draft in _munka/k6' },
    { title: 'Építés', detail: 'backend + tax engine, app, panel, guide images (only with args.epit)' },
    { title: 'Összeállítás', detail: 'integrate + deploy' },
    { title: 'Ellenőrzés', detail: 'independent tax recomputation + client journey, fix' },
    { title: 'Zárás', detail: 'APK, STATUS, pictures' },
  ],
}

const P = 'C:/Users/UpgradePC/konyvelo_app'
const K = `${P}/kod`
const D = `${P}/dizajn/C2_modern`
const W = `${P}/_munka/k6`
const HOST = '45-94-65-74.sslip.io'
const CTX = `PROJECT: the "Kézjegy" (working name; name only in ${K}/shared/brand.json) accountant service for Hungarian átalányadós, alanyi-ÁFA-mentes sole traders (egyéni vállalkozók); a real accountant approves every tax amount. LIVE: client app ${K}/app (Expo; https://app.${HOST}), panel ${K}/panel (https://konyvelo.${HOST}), backend ${K}/backend (Hono + Drizzle + Postgres; https://api.${HOST}), tax engine ${K}/ado-motor (2026 rules in src/rules/2026.ts), NAV Online Számla client ${K}/nav-kliens (demo mock), legal drafts ${K}/jogi, shared contracts ${K}/shared, spec ${K}/SPEC.md (§26 + §27 are the latest owner orders), features ${P}/FUNKCIOK.md.
DESIGN: layout from ${D}/app_v2/*.png + TERV.md, colours ${P}/dizajn/PALETTA.md (brand #1428DB), Geist, realistic 3D icons from ${D}/assets/ikon3d (NO line/vector icons, NO pastel circles), character avatar, object visuals; new screens must belong to this set.
SERVER: ssh appok-1, /srv/kezjegy; Gardoko shares Caddy and MUST keep working (https://${HOST}/api/v1/health before/after every deploy). LIVE DB: never wipe or reseed; pg_dump to /srv/kezjegy/_regi/ before any migration; migrations additive; keep the owner's accounts alex@demo.kezjegy.test, tulaj@demo.kezjegy.test and the demo logins bence.kovacs@demo.kezjegy.test (panel) and david@demo.kezjegy.test (client "Fendrik Dávid", formerly Kata) working with their data - the owner's accountant is using the last two right now.
TESTING: never type passwords on the live host; logged-in journeys run on the LOCAL harnesses (${K}/app README: npm run build in backend, npm run export:web, node scripts/helyi-proba.mjs -> http://127.0.0.1:8791, /__helyi/belep?ki=<seed user>; panel npm run dev or dev:mock). Own free ports. LOOK at every screenshot (headless Chrome, unique --user-data-dir).
RULES: never delete files (move to _regi/), never print secrets or passwords, no external logins or accounts, nobody logs in to NAV, only fake data in demos, Hungarian tegező UI copy (short, plain; "anyukád" not "anyád"; invoices are "kiállított számláid", never "a NAV-tól jött számla"), no AI mentioned in public texts.

THE OWNER'S ORDER (11-19 12:25, "Ez mind az 5 kell"), the five features:
1) "Ennyit tegyél félre" - for every incoming (issued) invoice and on the home screen: how much of it to put aside for taxes, explained in one line ("120 000 Ft-os számla - ebből kb. 22 000 Ft-ot tegyél félre"); must be honest about how the minimum bases (minimálbér / garantált bérminimum) and the adómentes rész make the marginal reserve non-linear - prefer a clear, conservative rule the accountant can stand behind, and show the year's running "félretenni javasolt" total vs. what is already due.
2) New-invoice notification: when the daily NAV sync finds a new issued invoice: push + in-app ("Új kiállított számlád: 120 000 Ft - Bodza Kiadó Kft. Tegyél félre kb. 22 000 Ft-ot."), batched if many, respecting notification settings and quiet hours.
3) 2026 personal allowances that change the tax of an átalányadós EV (családi kedvezmény and családi járulékkedvezmény, 25 év alatti fiatalok kedvezménye, 30 év alatti anyák kedvezménye, the mothers' SZJA exemptions with 2-3-4 children as phased in 2025-2026, első házasok kedvezménye, személyi kedvezmény): a short questionnaire in the client app (onboarding + Fiók), the accountant reviews/approves in the panel, the engine applies them correctly (with tests), and the client sees their effect.
4) "Mennyit kerestem?" - net income after taxes by month and year to date, plus a year-end projection, with a one-line plain explanation.
5) Change guides ("Változás-útmutatók"): how to report a move of the székhely, a new or changed activity (ÖVTJ), adding a telephely, and suspension (szüneteltetés) in the NAV Vállalkozói Ügysegéd ("Egyéni vállalkozással kapcsolatos adatváltozás bejelentése" has 4 steps: Személyi adatok, Vállalkozói címadatok, Tevékenységek, Ellenőrzés), tax-data changes via ONYA (T101E) as SPEC already notes, each with a "Kérj visszahívást / Intézzük helyetted" entry like §27. REAL screenshots exist: the owner logged in himself on 11-19 and we captured his own NAV screens in ${P}/utmutato_kepek/sajat/vallalkozas_bejelentes/_nyers/ (read OLVASS_EL.md there) - they contain HIS PERSONAL DATA and may be used ONLY after every personal value is blurred (names, mother's name, birth data, adóazonosító jel, adószám, statisztikai számjel, nyilvántartási szám, address, ügyazonosító); never copy those values into any text file, prompt, report or commit.`

const RES = { type: 'object', properties: { findings: { type: 'array', items: { type: 'object', properties: { topic: { type: 'string' }, fact: { type: 'string' }, source: { type: 'string' }, certainty: { type: 'string', description: 'official|secondary|uncertain' } }, required: ['topic', 'fact', 'source', 'certainty'] } }, engine_gaps: { type: 'array', items: { type: 'string' } }, recommendation: { type: 'string' } }, required: ['findings', 'engine_gaps', 'recommendation'] }
const DONE = { type: 'object', properties: { done: { type: 'array', items: { type: 'string' } }, files: { type: 'array', items: { type: 'string' } }, owner_todo: { type: 'array', items: { type: 'string' } }, problems: { type: 'array', items: { type: 'string' } } }, required: ['done', 'files', 'owner_todo', 'problems'] }
const ISS = { type: 'object', properties: { satisfied: { type: 'boolean' }, issues: { type: 'array', items: { type: 'object', properties: { severity: { type: 'string', description: 'blocker|major|minor' }, area: { type: 'string' }, where: { type: 'string' }, what: { type: 'string' }, fix: { type: 'string' } }, required: ['severity', 'area', 'where', 'what'] } }, checked: { type: 'array', items: { type: 'string' } } }, required: ['satisfied', 'issues', 'checked'] }

phase('Kutatás')
const ked = await agent(`${CTX}\n\nRESEARCH (no code changes) for feature 3, from OFFICIAL 2026 sources only (njt.hu: Szja tv. 29/A-29/F, 29/B, 29/C, 29/D, 29/E, 29/F and the new mothers' exemption sections, Tbj. 24. § családi járulékkedvezmény; NAV 2026 információs füzetek on átalányadózás and on the kedvezmények; NAV "Adóváltozások 2026"): for EACH allowance - who qualifies, amount or rate in 2026, monthly vs annual, how it applies to an átalányadós egyéni vállalkozó's SZJA base (átalányadó jövedelem) and in which order (adómentes rész first?), whether it can reduce TB-járulék (családi járulékkedvezmény) and whether szocho is affected, how it is claimed during the year for an EV (no employer adóelőleg-nyilatkozat: applied in the quarterly advances and settled in the annual return), the phase-in dates of the mothers' exemptions (3 children from 2025-10-01, 2 children under 40 from 2026-01-01, etc. - verify exactly), interaction rules (which ones can be combined, sharing családi kedvezmény between spouses), and the documents/data the accountant needs. Then read ${K}/ado-motor (rules, engine, tests) and list exactly what the engine does NOT support yet (engine_gaps). Also design note for feature 1: the exact 2026 marginal tax of one more forint of revenue for main-job / side-job / pensioner EVs at 45/80/90 % cost ratio, below and above the adómentes rész and the minimum járulék bases - so the reserve rule can be honest. Write everything also to ${W}/kedvezmenyek_2026.md (Hungarian, with sources).`, { label: 'kutatás:kedvezmények', phase: 'Kutatás', schema: RES })

phase('Terv')
const spec = await agent(`${CTX}\n\nRESEARCH: ${JSON.stringify(ked).slice(0, 16000)}\n\nYOUR JOB: write the contract for the five features so builders can work in parallel later, as ${W}/SPEC28.md (it becomes "§28 Öt új funkció 11-19" of ${K}/SPEC.md when the build starts - do NOT edit SPEC.md now, another job is editing it). Read the current code first (ado-motor API, backend tax/invoice/notification services, app home + dossier + Fiók screens, panel client page) and SPEC §26-27. Cover: (1) the reserve rule (formula, rounding, what is shown per invoice and on the home screen, the plain one-line explanation, when the number is only an estimate, how it relates to the accountant-approved amounts), (2) the new-invoice notification (trigger in the NAV sync job, dedupe, batching, settings, quiet hours, texts), (3) allowances: data model (client declaration + accountant approval, effective dates, children data minimised - no names/TAJ needed unless the law requires; GDPR note), questionnaire screens with final Hungarian copy, panel review UI, engine changes with test cases from the research (at least 10 hand-computed cases), (4) "Mennyit kerestem?" (definition of net income = revenue minus SZJA, TB, szocho, HIPA paid/approved/estimated; month and YTD; projection method), (5) the change guides (which changes, steps, real screenshot list from ${P}/utmutato_kepek/sajat/vallalkozas_bejelentes/_nyers/OLVASS_EL.md + blur rules + annotation, where they live in the app, callback/"Intézzük helyetted" entries). Screen-by-screen copy, API endpoints, enums, content keys, migrations (additive), and what each builder owns. Return a short summary.`, { label: 'terv:spec-28', phase: 'Terv', schema: DONE })

if (!(args && args.epit)) {
  log('Kutatás és terv kész; az építés a k5 után indul (args.epit)')
  return { ked, spec, varakozik: true }
}

phase('Építés')
const kata = await agent(`${CTX}

RESEARCH (no code changes) - owner 11-19 17:20: "A katásokat is tegyük be, azoknak is csináljuk." From OFFICIAL 2026 sources (njt.hu 2022. évi XIII. törvény (Katv.) as in force in 2026, NAV 2026 KATA információs füzet and GYIK, Áfa tv. for alanyi mentesség): who may be a kisadózó (only egyéni vállalkozó; income only from private persons - what happens if he invoices a business: the 40 % extra tax and when it applies, exceptions), the monthly tax (50 000 / 75 000 Ft), due date (the 12th of the following month), the yearly revenue limit (18 000 000 Ft, prorated by months) and the 40 % tax above it, the annual declaration (KATA bevallás/nyilatkozat, deadline), entering and leaving KATA (when, how, effect on the same year; switching to átalányadó and back - waiting periods), kieső idő / months without tax (szünetelés, táppénz, CSED/GYED), insurance and benefit bases, HIPA for kisadózók (KIVA-free; HIPA tételes vs normal), ÁFA (alanyi mentesség still applies), invoicing and NAV Online Számla (how to detect business customers from the invoices - customerVatStatus DOMESTIC/OTHER/PRIVATE_PERSON), bookkeeping duties, what an accountant does for a KATA client. Then read ${K}/ado-motor and list exactly what is missing to support KATA clients (monthly payable, limit meter, B2B warning, annual declaration, switching). Write ${W}/kata_2026.md (Hungarian, sources) and return findings + engine_gaps + recommendation.`, { label: 'kutatás:kata', phase: 'Építés', schema: RES })
const NEV = `\nNAME CHANGE (owner 11-19 13:05: "Adozz.hu lesz az app neve"): the product name becomes "Adózz" (written "Adózz.hu" where a web address is meant; the domain adozz.hu is NOT registered yet, so live URLs stay on ${HOST} until the owner buys it). The name lives in ONE config value (${K}/shared/brand.json - keep the old one in _regi): update it and everything derived from it (app title and Android label, panel title, e-mail sender name and templates, generated PDFs, legal drafts filled from brand.json, FAQ/content defaults if they hold the name), replace the old "Kézjegy" wordmark images with a new "Adózz" wordmark in the approved style (Geist, brand blue, no AI-generated lettering errors - set it as real text/SVG), keep package ids (com.somosi.kezjegy) and internal code names unchanged, and grep the whole repo for leftover "Kézjegy" in user-visible strings (internal identifiers may stay). Videos carry no product name - do not touch them for this.`
const SPECSUM0 = JSON.stringify(spec).slice(0, 3000)
const KIEG = `\nADDED ORDERS (owner 11-19 ~14:45, from his accountant's ideas, "Ez jó így ... csináljuk meg"): A) MONTHLY CHECK-IN "Változott valami?" - once a month a short yes/no check in the app (still főállású / mellékállású? - with the 36-hour employment threshold; also moved?, new activity?, new child / allowance change?, pension?): "Nem változott" confirms and ends; any "Igen" opens follow-up questions (e.g. new employment: from when, hours per week), explains in plain words what changes and the extra admin, shows the change fee if one applies and asks to PAY IT IN ADVANCE (SimplePay demo) before the team acts; the accountant/team gets a task. B) ANNUAL CLOSING FEE + QUESTIONNAIRE: besides the monthly fee an annual closing fee for preparing the annual SZJA return and the HIPA return; an in-app annual questionnaire (other incomes, allowances - reuse feature 3 -, HIPA data, anything the accountant needs), with deadline reminders. C) AUTOMATIC REMINDERS: document upload and tax payment reminders exactly when relevant (respecting settings + quiet hours), plus nudges after 3 and 7 days for open requests. D) UNPAID FEE LOCK: if the subscription/closing fee is unpaid (after the existing retry schedule), the client profile is LOCKED for accounting service (no approvals, letters, filings, new requests; the panel shows it) until payment - but paying, downloading his own data (GDPR) and writing to customer service keep working; clear wording. E) SUSPENSION FEE: while the business is suspended (szünetel), a small monthly availability fee (rendelkezésre állási díj) instead of the full fee. F) EFO / EMPLOYEES: we do not do payroll now - at onboarding (and in the monthly check) ask "Van alkalmazottad vagy egyszerűsített foglalkoztatottad (EFO)?"; if yes the app says it plainly and the accountant decides in the panel (individual offer or decline). G) PUBLIC TAX CALCULATOR (owner 11-19 15:25 "mehet nyugodtan"): a public page without login on the client web origin (e.g. /kalkulator, also embeddable later on the future adozz.hu site): "Mennyi adót fizetnél egyéni vállalkozóként?" - inputs: expected yearly revenue, activity (cost ratio 40/45/80/90 % via the activity list), main job / side job (36 h employment) / pensioner, optional allowances (reuse feature 3 in a light form); output per year and per quarter (SZJA, TB, szocho, HIPA estimate, net income, "ennyit tegyél félre havonta"), the ÁFA-limit note for starters, plain one-line explanations, an honest "becslés" note, and CTAs "Regisztrálok" / "Kérek visszahívást" (UTM kept); runs on the same tax engine (no duplicated rules), stores nothing unless the visitor registers, fast on a phone, SEO title/description, no AI mentioned. H) AUTO-FILL BY ADÓSZÁM (Billingo-like, owner liked it): in onboarding for an existing business the client types only the adószám; the backend calls NAV Online Számla queryTaxpayer through ${K}/nav-kliens with OUR OWN (Somosi Kft.) technical user (env vars, not configured yet -> DEMO mock in demo, clear "DEMO" note) and pre-fills name, székhely, egyéni vállalkozó status and ÁFA code (warn on non-alanyi-mentes codes per §27); the client only confirms or corrects; rate limit 1 req/s respected, results not stored beyond the client's own profile; one question per screen with a big Tovább button and a back arrow, like the §27 flow. Type-ahead feel: the lookup fires as soon as the 8th digit of the adószám is typed and a card pops up "Ez a te vállalkozásod?" (name + székhely) to confirm with one tap. MANY CLIENTS DO NOT KNOW THEIR ADÓSZÁM (owner 15:45): under the field a "Hol találom?" sheet with the places in plain words (top of any invoice you issued - seller's adószám; your invoicing app's settings, e.g. Billingo / Számlázz.hu; NAV letters; NAV Ügyfélportál home page "Saját adatok" box after login; the EV registration confirmation), and a "Most nem tudom" button: the client gets the manual form and types by hand every field the lookup would have filled (vállalkozás neve, székhely, tevékenység, egyéni vállalkozó since when, alanyi ÁFA-mentes igen/nem; owner 15:50: "Most nem tudom -> manuálisan adom meg az adatokat"), each one question per screen with the same explainers, and the accountant fills the adószám later from ONYA once the meghatalmazás is active (panel task); never block onboarding on it. I) APP-WIDE CLARITY + SIZE PASS (owner 11-19 16:55: "Úgy minden túl nagy szerintem, ezért nem annyira átlátható"; he chose mockup variant B incl. its bottom bar): the OWNER-APPROVED reference is ${P}/dizajn/C4_atlathato/B_kisebb/ (fooldal.html/.png and urlap.html/.png - owner 11-19 17:10: "Sokkal jobb így, egész appot megcsinálod ilyen stílusra!"); its exact CSS scale and layout are the standard; ideas from ${P}/dizajn/C4_atlathato/C/ and VALASZTAS.md may be used only where they keep B_kisebb's structure and sizes; apply it to EVERY client screen (and the panel's typography/spacing where it is oversized) - one main button in a fixed place at the bottom, the same section header everywhere (3D icon + blue title + one sentence + at most one action), two text levels, at most one text link per screen ("Mi ez?" -> small round i), no box inside a box, only now + next steps visible with the rest collapsed, every message once - and a SMALLER, calmer type and spacing scale app-wide (screen title ~24-26 px, section title 18, body 16, secondary 14-15 with >= 4.5:1 contrast, icons 28-32 px, main button 52 px, 8/12/16/24 spacing), B's flat full-width bottom tab bar; keep colours, Geist, 3D icons and avatar; keep 44 pt tap targets and large-text accessibility. Screenshot every main screen before/after at 390x844 and LOOK. J) KATA CLIENTS (owner 11-19 17:20 "a katásokat is ... csináljuk"): support kisadózó (KATA) sole traders end to end, using the research in ${W}/kata_2026.md (summary: ${JSON.stringify(kata).slice(0, 3500)}): onboarding asks the tax regime (átalányadó / KATA / nem tudom - then we help), the engine computes the monthly KATA tax (50 000 / 75 000 Ft), due-date reminders, the 18 M Ft (prorated) revenue meter with warnings, a CLEAR WARNING when an invoice goes to a business customer (40 % tax risk; detect from NAV customerVatStatus), months without tax (szünetelés etc.), the annual KATA declaration task for the accountant, switching between KATA and átalányadó with the legal timing rules (the "Változott valami?" check asks it too); the home, Számlaszámok, félretenni and "Mennyit kerestem?" screens show the KATA view; the panel shows the regime per client; the KATA plan price is the SAME 19 999 Ft as the átalányadó plan (owner 11-19 17:25: "Ugyanannyi lesz"; still admin-editable); legal drafts and FAQ cover KATA; demo data: one KATA demo client (fake). K) PATTERNS FROM ACCOUNTABLE (owner 11-19 19:05 agreed; research ${P}/_munka/accountable_2026-11-19.json, internal reference shots ${P}/dizajn/C4_atlathato/_inspiracio/accountable/ - borrow the PATTERN only, in our B_kisebb look; never their purple, pastel colour coding, mascot, tiny type, hamburger menu or "+" FAB): (1) after onboarding the home shows TWO big numbers "Idei bevételed" and "Eddigi adód" (KATA: "Idei bevétel" and the 18 M meter); (2) a payment card "Utalj X Ft-ot <dátum>-ig" with payee, account number and közlemény copy buttons and the main button "Elutaltam"; (3) a put-aside ring "Még X Ft-ot tegyél félre" tied to feature 1; (4) deadlines grouped by quarter (collapsed rows with the amount); (5) photo capture with pre-filled amount/date and the line "Bence ellenőrzi"; status tabs with counts in lists (e.g. Feltöltve 3 / Bence látta 2 / Kész 12); (6) every client gets a personal forwarding e-mail address for receipts and bank statements (incoming mail -> attachments into the dossier of the right month, sender checks, size/type limits; DEMO mailbox until a mail provider is configured) and Messages offers 3-4 suggested questions. Also: no paywall surprises - everything is in the one plan. PRICES: the monthly fee is 19 999 Ft (gross) - change every place that says 20 000 (plans, texts, ÁSZF drafts, e-mails, PDFs, FAQ, FUNKCIOK, demo data that shows the price); the annual closing fee, the change fees and the suspension fee are ADMIN-EDITABLE settings (shown with a DEMO mark until the owner confirms them). CHANGE FEES (owner 11-19 ~15:00, "Ez jó lesz"): a change the client files HIMSELF with our guide = 0 Ft (we only update our side); an assisted simple change ("Intézzük helyetted": move of székhely, new/changed activity, telephely, szüneteltetés bejelentése) = 4 999 Ft; a change of legal status (főállás <-> mellékállás, became pensioner) = 7 999 Ft, paid in advance before the team acts. Demo values for the others: annual closing fee 14 999 Ft, suspension availability fee 2 999 Ft/month. Write these as "§28.K kiegészítés" into the SPEC with copy, data model, endpoints and who owns what.`
const kieg = await agent(`${CTX}\n\nCONTRACT SO FAR: ${W}/SPEC28.md (summary: ${SPECSUM0}).${KIEG}\n\nYOUR JOB: append §28 (from SPEC28.md) and the new §28.K to ${K}/SPEC.md (copy SPEC.md to ${K}/_regi/ first), update ${K}/shared types/enums/content keys for both, keep them compiling. Read the existing subscription/payment, notification, onboarding and request code first so §28.K fits. Return a short summary.`, { label: 'terv:spec-28k', phase: 'Építés', schema: DONE })
const SPECSUM = (SPECSUM0 + ' | §28.K: ' + JSON.stringify(kieg)).slice(0, 4500)
const B = (job, label) => () => agent(`${CTX}\n\nCONTRACT: ${W}/SPEC28.md (summary: ${SPECSUM}); research ${W}/kedvezmenyek_2026.md. §28 and §28.K are already in ${K}/SPEC.md and ${K}/shared (read them there).${KIEG}\n\nYOUR JOB: ${job}\nWork ONLY in your own folders; contract changes go to the §28 builder notes. Run typecheck + tests. Do NOT deploy. Return what you built and problems.${NEV}`, { label, phase: 'Építés', schema: DONE })
const built = await parallel([
  B(`backend + tax engine + shared (${K}/backend, ${K}/ado-motor, ${K}/shared, additive migrations): the §28.K backend parts (monthly check-in tasks, change-fee prepayment, annual closing fee + questionnaire storage, reminder schedules, unpaid-fee lock enforced in the API, suspension fee, EFO flag, 19 999 Ft everywhere, admin-editable fees); the allowances in the engine with the hand-computed tests, the declaration/approval model and endpoints, the reserve calculation API, the new-invoice notification in the sync job, the net-income endpoint, the change-guide content keys/texts. Demo data: give a few demo clients sensible allowance declarations (never touch alex@, tulaj@; david@ only if harmless).`, 'építés:backend'),
  B(`client app ${K}/app: reserve line on every invoice + the home-screen reserve card, notification handling, the allowance questionnaire (onboarding + Fiók) with status (beküldve / könyvelő jóváhagyta), the "Mennyit kerestem?" screen, the change guides with the annotated real screenshots (zoomable), the §28.K screens (monthly check-in, change-fee prepayment, annual questionnaire, locked-profile state, suspension fee, EFO question), 19 999 Ft everywhere, all in the approved design. Screenshots 390x844 + 320x640 into ${K}/_qa/k6_app_*.png and LOOK.`, 'építés:app'),
  B(`panel ${K}/panel: allowance review/approve per client (with the effect on the quarter), the §28.K panel parts (check-in answers and change tasks, annual questionnaire review, locked/unpaid and suspended states, EFO decision, admin-editable fee settings), the reserve and net-income figures on the client page, notification log; screenshots 1440x900 into ${K}/panel/_kepek/k6_*.png and LOOK. ALSO the change-guide IMAGES: from ${P}/utmutato_kepek/sajat/vallalkozas_bejelentes/_nyers/ make blurred + annotated images with the existing tools (${P}/utmutato_kepek/annotate.py / sajat_kepek.py conventions) into ${P}/utmutato_kepek/valtozas/ with index.json; blur whole value areas so no personal value survives, verify by LOOKING at every output at 200 % and with OCR (pytesseract if available) that none of the personal values remain; never write the values anywhere.`, 'építés:panel+képek'),
])

phase('Összeállítás')
const integ = await agent(`${CTX}\n\nBUILDERS: ${JSON.stringify(built).slice(0, 10000)}\n\nINTEGRATOR: make it fit, full tests green, then deploy safely (Gardoko health, pg_dump, additive migrations, backend + worker + web + panel + media/guide images the documented way), verify the owner's and demo accounts still work with their data (SQL counts only), smoke-test public URLs, walk the five features once on the local harness and LOOK (${K}/_qa/k6_integ_*.png); confirm the new name shows everywhere user-visible.${NEV} Return what is live.`, { label: 'összeállítás:integrátor', phase: 'Összeállítás', schema: DONE })

phase('Ellenőrzés')
const LENS = [
  { k: 'adó', p: `TAX: recompute BY HAND from the official 2026 rules at least 12 cases (each allowance alone and combined, main/side job, 45/80/90 %, crossing the adómentes rész, under/over the minimum bases) and compare with the engine, the reserve numbers per invoice and on the home screen, and "Mennyit kerestem?"; check the notification texts' numbers too. Any wrong forint is a blocker.` },
  { k: 'ügyfél', p: `CLIENT JOURNEY at 390x844 and 320x640 as a non-accountant: is every new number understandable in one line, honest about estimates, consistent between home, invoice, notification and net-income screens? Allowance questionnaire: short, no unnecessary personal data, status clear; panel approval flows back. Change guides: images sharp, NO personal value visible anywhere (zoom in), steps match the real NAV screens, callback entry present. §28.K: monthly check-in both answers, prepayment before the change, annual questionnaire, unpaid lock (service blocked, but paying, data download and support messages still work - verify at API level), suspension fee, EFO question, no 20 000 Ft left anywhere (19 999).` },
]
let checks = await parallel(LENS.map(l => () => agent(`${CTX}\n\nADVERSARIAL CHECK - try to prove the feature is NOT done right. ${l.p} Screenshots ${K}/_qa/k6c_${l.k}_*.png, LOOK at them.`, { label: `ell:${l.k}`, phase: 'Ellenőrzés', schema: ISS })))
for (let r = 1; r <= 2; r++) {
  const issues = checks.filter(Boolean).flatMap(c => c.issues)
  const bad = checks.filter(Boolean).some(c => !c.satisfied) || issues.some(i => /blocker|major/i.test(i.severity))
  log(`Ellenőrzés ${r}: ${issues.length} észrevétel${bad ? ', javítás kell' : ''}`)
  if (!issues.length) break
  await agent(`${CTX}\n\nFIXER: fix all blockers/majors and sensible minors (dedupe first), tests, redeploy the same safe way, re-screenshot and LOOK.\n\nISSUES:\n${JSON.stringify(issues).slice(0, 38000)}`, { label: `ell:javítás${r}`, phase: 'Ellenőrzés' })
  if (!bad) break
  checks = await parallel(LENS.map(l => () => agent(`${CTX}\n\nADVERSARIAL RE-CHECK (round ${r + 1}) - ${l.p} Screenshots ${K}/_qa/k6c${r + 1}_${l.k}_*.png, LOOK.`, { label: `ell${r + 1}:${l.k}`, phase: 'Ellenőrzés', schema: ISS })))
}

phase('Zárás')
const zaras = await agent(`${CTX}\n\nWRAP-UP: NO Android APK this time (owner 11-19 17:30: "APK nem kell még") - do not build or upload one; update ${P}/STATUS.md (short Hungarian, phone-readable: the five features, what is DEMO, what the owner/accountant must decide); pick 6-8 screenshots showing the five features and write their paths in order to ${W}/kuldendo.txt (LOOK at each). Checks: ${JSON.stringify(checks).slice(0, 3000)}. Return the STATUS text.`, { label: 'zárás', phase: 'Zárás' })
return { ked, spec, built, integ, checks, zaras }