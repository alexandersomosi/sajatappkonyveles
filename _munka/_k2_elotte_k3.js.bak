export const meta = {
  name: 'kezjegy-k2-ellenorzo-korok',
  description: 'Extra verification rounds for the accountant-app system: 6 independent reviewers per round, two fixers on disjoint folders, redeploy; stop after 2 clean rounds or 5 rounds; final APK, status and morning images',
  phases: [
    { title: 'Kör', detail: '6 reviewers -> 2 fixers -> redeploy, repeated' },
    { title: 'Zárás', detail: 'APK, STATUS.md, morning images' },
  ],
}

const P = 'C:/Users/UpgradePC/konyvelo_app'
const K = `${P}/kod`
const D = `${P}/dizajn/C2_modern`
const HOST = '45-94-65-74.sslip.io'
const MAX = (args && args.maxRounds) || 5
const CTX = `PROJECT: the "Kézjegy" (working name) accountant service for Hungarian átalányadós, alanyi-ÁFA-mentes sole traders: client app (${K}/app, Expo; live web https://app.${HOST}), accountant + admin panel (${K}/panel; https://konyvelo.${HOST}), backend (${K}/backend; https://api.${HOST}), tax engine (${K}/ado-motor), NAV Online Számla client (${K}/nav-kliens), legal drafts (${K}/jogi), deploy files (${K}/deploy); spec ${K}/SPEC.md; scope ${P}/FUNKCIOK.md; status ${P}/STATUS.md. Server: ssh alias appok-1, project in /srv/kezjegy (own compose, own Postgres), Caddy shared with the Gardoko app which MUST keep working (check https://${HOST}/api/v1/health before and after any deploy; copy shared files to /srv/appok/_regi/ before changing them). Demo logins are only in /srv/kezjegy/demo_belepesek.txt on the server (read them there; never print them in reports).
APPROVED DESIGN: ${D}/app_v2/*.png + TERV.md (Geist, ink-blue, white sheets on tinted ground, accountant letter with signature, big amount band), realistic 3D icons from ${D}/assets/ikon3d (NO line/vector icons anywhere, NO pastel circles), the drawn character avatar ${D}/assets/avatar/karakter_1_lapos*, realistic object visuals ${D}/assets/illusztraciok.
OWNER: asked for MORE verification rounds ("csinálj még több ellenőrző kört") - be thorough. External accounts (SimplePay, Brevo, Google, NAV test env, domain) are not available: DEMO modes must work and be clearly labelled; production paths must be correct per official docs.
RULES: never delete files (move to _regi/), never print or commit secrets or demo passwords, no logins or accounts on external services, never touch vett.hu, only fake data, attack nothing outside our own server. Hungarian UI copy (tegeződés). LOOK at every screenshot you take (headless Chrome, unique --user-data-dir per shot, forward-slash paths).
TESTING LOGGED-IN FLOWS: never type passwords on the live host (45-94-65-74.sslip.io is not a local/test host). Run every logged-in journey on the LOCAL harnesses with the demo seed instead: client app ${K}/app (npm run build in ${K}/backend, npm run export:web, then node scripts/helyi-proba.mjs -> http://127.0.0.1:8791, /__helyi/belep?ki=kata logs in a seed user; see ${K}/app/README.md), panel ${K}/panel (npm run dev -> http://localhost:5174 proxied to a local backend, or npm run dev:mock; see ${K}/panel/README.md). Use unique ports if another reviewer already runs one. On the live host check only public pages, headers, health, unauthenticated API behaviour and that the deployed build matches the local one.`

const ISS = { type: 'object', properties: { issues: { type: 'array', items: { type: 'object', properties: { severity: { type: 'string', description: 'blocker|major|minor' }, area: { type: 'string', description: 'app|panel|backend|ado-motor|nav-kliens|jogi|deploy' }, where: { type: 'string' }, what: { type: 'string' }, fix: { type: 'string' } }, required: ['severity', 'area', 'where', 'what'] } }, checked: { type: 'array', items: { type: 'string' } } }, required: ['issues', 'checked'] }
const LENSES = [
  { k: 'ügyfél', p: `CLIENT JOURNEY: on the live web app (390x844 and 320x640) and the API, as a brand-new fake client and as the demo client: register, password reset, onboarding (contract + meghatalmazás PDF, AVDH guidance, signed-PDF upload, ID upload + declarations), NAV invoices arriving (demo), approved amount + letter, Számlaszámok copy, Már befizettem, Hogyan jött ki?, limit meters, dossier by month + statuses, item detail, document capture/upload (photo, multi-page, PDF), messages + requests + certificate request, deadlines, subscription (SimplePay demo), settings (biometric/2FA/notifications), data export, account delete. Screenshots ${K}/_qa/k2_<round>_ugyfel_*.png.` },
  { k: 'könyvelő', p: `ACCOUNTANT + ADMIN JOURNEY on the live panel (1440x900 and 1280x720): process a new client end to end, approve a tax period and publish the letter, mark a return filed with PDF + NAV receipt, document status changes, requests both ways, messages, certificate queue, weekly deadline board, CSV export, admin: subscriptions/failed payments, revenue, workload, referral codes, texts, audit log. Screenshots ${K}/_qa/k2_<round>_konyvelo_*.png.` },
  { k: 'biztonság', p: `SECURITY: code + live review of our own deployment only: authN/authZ on every endpoint (IDOR between clients, client->accountant/admin escalation), sessions/refresh/logout, password reset abuse, rate limits, file upload validation (type, size, path traversal), encryption at rest of files and NAV credentials (verify on disk/DB), SimplePay IPN signature + replay, CORS/headers/cookies, secrets in repo/images/logs, Docker/Caddy exposure (only 80/443 public), backups, dependency audit (npm audit).` },
  { k: 'dizájn', p: `DESIGN FIDELITY: compare every client screen and panel page with the approved C2 PNGs and TERV.md: typography (Geist, scale, tabular amounts), colours, spacing, sheets vs ground, button hierarchy, the 3D icons everywhere (list ANY remaining line/vector icon), the character avatar, object visuals in empty states, motion where specified, nothing generic or templated, nothing blending (squint test: blur screenshots with PIL GaussianBlur 6). Screenshots ${K}/_qa/k2_<round>_dizajn_*.png.` },
  { k: 'adó-és-nyelv', p: `TAX + LANGUAGE CORRECTNESS: independently recompute (by hand, from official 2026 NAV/jogszabály sources you look up yourself) at least 8 cases (main job, side job, pensioner, 40/80/90% cost ratio, adómentes rész crossing, quarter boundary, minimum járulék bases, HIPA) and compare with ${K}/ado-motor and the amounts the app shows; check limit meters and deadlines; read ALL Hungarian UI and legal texts for wrong terms, unnatural phrasing, inconsistency, English leftovers, missing ő/ű glyphs.` },
  { k: 'robosztusság', p: `ROBUSTNESS + ACCESSIBILITY: empty states, very long names, 200 documents in a month, 20 MB PDFs, bad photos, slow 3G and offline then online, session expiry mid-upload, double taps on payment/approve buttons, concurrent edits by client and accountant, server restart, time zones and month boundaries; large text setting, screen reader labels, contrast, 44-56 pt tap targets, reduced motion; Android APK basics if an emulator is unavailable then the web build at phone size.` },
]

let clean = 0
const history = []
for (let round = 1; round <= MAX && clean < 2; round++) {
  phase('Kör')
  const res = await parallel(LENSES.map(l => () => agent(`${CTX}\n\nROUND ${round}. ${l.p.replaceAll('<round>', String(round))}\nAlready fixed in earlier rounds (do not re-report unless broken again): ${JSON.stringify(history.map(h => h.fixed)).slice(0, 4000)}`, { label: `kör${round}:${l.k}`, phase: 'Kör', schema: ISS })))
  const all = res.filter(Boolean).flatMap(r => r.issues)
  const serious = all.filter(i => /blocker|major|critical|high/i.test(i.severity))
  log(`Kör ${round}: ${all.length} észrevétel, ebből ${serious.length} komoly`)
  if (!all.length) { clean++; history.push({ round, fixed: 'nothing to fix' }); continue }
  const front = all.filter(i => /app|panel/i.test(i.area))
  const back = all.filter(i => !/app|panel/i.test(i.area))
  const FIX = (list, owns) => agent(`${CTX}\n\nROUND ${round} FIXER. You own ONLY these folders: ${owns}. Another fixer works on the other folders in parallel - do not edit theirs; if a fix needs a change there, describe it in your problems list. Dedupe, then fix all blockers/majors and sensible minors, run tests, redeploy your part (Gardoko must keep working), re-screenshot what you touched and LOOK. Return a short summary.\n\nISSUES:\n${JSON.stringify(list).slice(0, 38000)}`, { label: `kör${round}:javítás:${owns.split(',')[0].trim().split('/').pop()}`, phase: 'Kör' })
  const fx = await parallel([
    () => front.length ? FIX(front, `${K}/app, ${K}/panel`) : Promise.resolve('no front-end issues'),
    () => back.length ? FIX(back, `${K}/backend, ${K}/ado-motor, ${K}/nav-kliens, ${K}/jogi, ${K}/deploy`) : Promise.resolve('no back-end issues'),
  ])
  history.push({ round, issues: all.length, serious: serious.length, fixed: fx.map(f => String(f).slice(0, 1500)) })
  clean = serious.length === 0 ? clean + 1 : 0
}
log(`Ellenőrző körök vége: ${history.length} kör`)

phase('Zárás')
const apk = await agent(`${CTX}\n\nRebuild the Android test APK of ${K}/app (same method as the previous build; Android SDK D:/Atvitel/Android/Sdk, JDK 17 C:/Users/UpgradePC/jdk-17/jdk-17.0.12+7, the windows-path.init.gradle trick, package com.somosi.kezjegy, debug-signed), bump the version, put it into ${P}/apk/ (keep older ones), report size + sha256. Verify the web builds on the server are the latest.`, { label: 'zárás:apk', phase: 'Zárás' })
const status = await agent(`${CTX}\n\nUpdate ${P}/STATUS.md in plain short HUNGARIAN for the owner who just woke up (max 50 lines): what he can try now (3 URLs, newest APK path + install steps, the exact ssh command to read the demo logins), what is finished, what the ${history.length} verification rounds found and fixed (short), what is still DEMO and exactly what HE must do (SimplePay keys, Brevo, Google client ID, domain + final name, NAV test registration of the Kft., lawyer review of ${K}/jogi, the accountant's details) and how to run ${P}/kezjegy_kulcsok.ps1. Make ${P}/_reggel.jpg (8 key client screens + 2 panel pages, <= 2600 px wide; LOOK at it) and ${P}/_reggel_sorrend.txt (full-size screenshot paths in a good order to send one by one). Rounds: ${JSON.stringify(history).slice(0, 6000)}; APK: ${String(apk).slice(0, 1500)}. Return the STATUS text.`, { label: 'zárás:státusz', phase: 'Zárás' })
return { rounds: history, apk, status }
