const K = `${P}/kod`
const D = `${P}/dizajn/C2_modern`
const W = `${P}/_munka/k5`
const HOST = '45-94-65-74.sslip.io'
const K4J = 'C:/Users/UpgradePC/.claude/projects/C--Users-UpgradePC/87bd1012-c50f-48f0-975b-1b47560d5083/subagents/workflows/wf_f9dfda1c-a0b/journal.jsonl'

const CTX = `PROJECT: the "Kézjegy" (working name; the name lives only in ${K}/shared/brand.json) accountant service for Hungarian átalányadós, alanyi-ÁFA-mentes sole traders, sold by Somosi Kft.; a real human accountant (demo "Kovács Bence", a subcontractor) is the NAV meghatalmazott. BUILT and LIVE: client app ${K}/app (Expo + expo-router; web https://app.${HOST}), accountant + admin + team panel ${K}/panel (https://konyvelo.${HOST}), backend ${K}/backend (Hono + Drizzle + Postgres; https://api.${HOST}), tax engine ${K}/ado-motor, NAV client ${K}/nav-kliens, legal drafts ${K}/jogi, deploy ${K}/deploy, shared contracts ${K}/shared; spec ${K}/SPEC.md (§26 = the 11-18 owner orders: new-business self-service path, callback instead of booking, bottom bar + restricted account during onboarding, Mi ez?/Miért kell?/Hol találod? explainers, explainer + 2 guide videos, annotated NAV screenshots in ${P}/utmutato_kepek/); scope ${P}/FUNKCIOK.md; status ${P}/STATUS.md.
APPROVED DESIGN: layout from ${D}/app_v2/*.png + TERV.md; COLOURS from ${P}/dizajn/PALETTA.md + ${P}/dizajn/C3_zold/kek.css (brand vivid blue #1428DB, reference ${P}/dizajn/C3_zold/03_fooldal_kek.png); Geist; realistic 3D icons from ${D}/assets/ikon3d (NO line/vector icons, NO pastel circles); the drawn character avatar ${D}/assets/avatar/karakter_1_lapos*; object visuals ${D}/assets/illusztraciok. New screens must look like they belong to this set.
SERVER: ssh alias appok-1, project /srv/kezjegy (own compose + Postgres); Caddy is shared with the Gardoko app which MUST keep working (https://${HOST}/api/v1/health before and after every deploy; copy shared files to /srv/appok/_regi/ before changing them). LIVE DATA: never wipe or reseed the live DB; the owner's accounts alex@demo.kezjegy.test and tulaj@demo.kezjegy.test and their onboarding progress must survive (pg_dump to /srv/kezjegy/_regi/ before any migration; migrations additive). Demo logins only in /srv/kezjegy/demo_belepesek.txt - never print them.
TESTING: never type passwords on the live host (not a local/test host). Logged-in journeys run on the LOCAL harnesses with the demo seed: client app (npm run build in ${K}/backend, npm run export:web in ${K}/app, then node scripts/helyi-proba.mjs -> http://127.0.0.1:8791, /__helyi/belep?ki=<seed user>; see ${K}/app/README.md), panel (npm run dev in ${K}/panel, or npm run dev:mock; see ${K}/panel/README.md). Use your own free ports. LOOK at every screenshot you take (headless Chrome, unique --user-data-dir per shot, forward-slash paths).
RULES: never delete files (move to _regi/), never print or commit secrets or demo passwords, no logins or accounts on external services, nobody of us logs in to NAV / Ügyfélkapu+ / DÁP, never touch vett.hu, only fake data. Hungarian UI copy with tegeződés, plain short words, no AI mentioned in public texts.

THE OWNER'S NEW ORDERS (11-19, his notes, translated):
1) "For the new-business registration REAL screenshots are needed." Today 17 of the 18 pictures of the new-business guide (${P}/utmutato_kepek/vallalkozas_bejelentes/) are drawn "Illusztráció" because no official screenshot of the 2026 NAV Vállalkozói Ügysegéd was found (${P}/utmutato_kepek/hianyzik.md, forrasok.json). The meghatalmazás guide already has 16 real ones.
2) "If I choose that I have NO business, I cannot switch back to 'I already have one', even when I do." The branch choice must be changeable.
3) "If someone is not technical enough, they can ask US to register the business for them - this needs a callback. The meghatalmazás too: if needed we do it for them - THIS MUST BE HIGHLIGHTED (ki kell emelni)."
4) "The flow should still be improved. 'anyukád' instead of 'anyád' (client-facing tegező texts say 'anyád neve'; legal documents may keep the term 'anyja neve'). The flow is important, it is still not transparent enough - look at it with a user's eyes too."
POLICY FOR ORDER 3: self-service stays the default, but an ASSISTED path ("Intézzük helyetted") is offered on request after a callback (a team member calls within 24-48 h). We NEVER ask for, store or use the client's Ügyfélkapu+/DÁP credentials and never log in as the client; we act only as a registered meghatalmazott, the client approves/confirms what is needed himself. Legal texts are drafts for the lawyer (the zugírászat / Üttv. question for the non-tax EV registry part stays flagged).
EARLIER WORK TO REUSE: research + spec + integration results of the 11-18 job in ${W}/k3_eredmenyek.json (EV registration facts incl. UJEGYKE / representation, callback UX); the verification job was stopped in round 2 and its finished findings are NOT fixed yet: ${W}/k3_kor2_nyitott.json (security 16, tax + language 13 incl. 1 blocker about revenue in an already approved quarter, owner-orders audit 17).
VIDEOS: another job may still be finishing the voiced videos in ${P}/video/ (journal ${K4J}); do not touch ${P}/video unless your job says so.`

const DONE = { type: 'object', properties: { done: { type: 'array', items: { type: 'string' } }, files: { type: 'array', items: { type: 'string' } }, owner_todo: { type: 'array', items: { type: 'string' } }, problems: { type: 'array', items: { type: 'string' } } }, required: ['done', 'files', 'owner_todo', 'problems'] }
const RES = { type: 'object', properties: { findings: { type: 'array', items: { type: 'object', properties: { topic: { type: 'string' }, fact: { type: 'string' }, source: { type: 'string' }, certainty: { type: 'string', description: 'official|secondary|uncertain' } }, required: ['topic', 'fact', 'source', 'certainty'] } }, recommendation: { type: 'string' }, open_questions: { type: 'array', items: { type: 'string' } } }, required: ['findings', 'recommendation', 'open_questions'] }
const UX = { type: 'object', properties: { problems: { type: 'array', items: { type: 'object', properties: { severity: { type: 'string', description: 'blocker|major|minor' }, persona: { type: 'string' }, screen: { type: 'string' }, what: { type: 'string' }, why_confusing: { type: 'string' }, idea: { type: 'string' }, screenshot: { type: 'string' } }, required: ['severity', 'screen', 'what', 'idea'] } }, branch_lock: { type: 'string', description: 'where and why the have-a-business choice cannot be changed (UI, API, DB)' }, wording: { type: 'array', items: { type: 'string' }, description: 'every client-facing anyád/anyja occurrence with file:line' }, flow_map: { type: 'string' }, screenshots: { type: 'array', items: { type: 'string' } } }, required: ['problems', 'branch_lock', 'wording', 'flow_map', 'screenshots'] }
const ISS = { type: 'object', properties: { satisfied: { type: 'boolean' }, issues: { type: 'array', items: { type: 'object', properties: { severity: { type: 'string', description: 'blocker|major|minor' }, area: { type: 'string', description: 'app|panel|backend|jogi|media|deploy' }, where: { type: 'string' }, what: { type: 'string' }, fix: { type: 'string' } }, required: ['severity', 'area', 'where', 'what'] } }, checked: { type: 'array', items: { type: 'string' } } }, required: ['satisfied', 'issues', 'checked'] }

phase('Felmérés')
const [jog, kepek, ux] = await parallel([
  () => agent(`${CTX}\n\nRESEARCH (no code changes) for ORDER 3. Read ${W}/k3_eredmenyek.json first (kutatás:ev-indítás already found: UJEGYKE on VEGYES ÜGYEK -> "Egyéni vállalkozói nyilvántartással kapcsolatos ügyek (kivéve adóügyek)" lets a meghatalmazott act fully in the Vállalkozói Ügysegéd; the meghatalmazás belongs to the person's adóazonosító jel so it can be given BEFORE the business exists; if the meghatalmazott submits UJEGYKE the client must approve it in ONYA within 4 calendar days; Air. 17. § lists the könyvelő and accounting companies; Üttv. / Btk. 286. § risk for the non-tax part). Do not redo that - verify the open points and complete them from OFFICIAL sources (nav.gov.hu, ONYA/Ügyfélportál help, magyarorszag.hu, njt.hu laws): (A) WE SET UP THE MEGHATALMAZÁS: exact steps when our accountant (natural person) or Somosi Kft. as an accounting company submits UJEGYKE for the client - which ügycsoportok (ADÓÜGYEK + the EV-registry group), what the client then sees (NAV notification / ONYA tárhely), exactly how he approves (screens; reuse the real images in ${P}/utmutato_kepek/meghatalmazas/ where they show it), deadline, what if he misses it; alternatives for clients without Ügyfélkapu+ (DÁP ügyintézési rendelkezés, paper meghatalmazás with two witnesses at a NAV office) and which is the least effort for a non-technical person. (B) WE FILE THE EV BEJELENTÉS FOR HIM: can a meghatalmazott start a NEW egyéni vállalkozás in the Vállalkozói Ügysegéd (find the most explicit official sentence; secondary sources marked), what the representative must have, what the client must confirm beforehand (data, ÖVTJ, adózási választások - átalányadó + alanyi ÁFA-mentesség must be chosen AT registration), irrevocability, where the confirmation and the adószám arrive and how the client gets them. (C) RISK + WORDING: what structure and wording lower the zugírászat risk (e.g. könyvelő acting under Air. 17. §, the help being part of the bookkeeping service, written client confirmation of the data before filing), and the hard limits: never ask for credentials, never log in as the client. (D) The SIMPLEST assisted journey for a non-technical client, step by step with who acts (ügyfél / mi / NAV), how long each takes, and the statuses the app should show. Return findings + a clear recommendation.`, { label: 'kutatás:helyettünk', phase: 'Felmérés', schema: RES }),
  () => agent(`${CTX}\n\nORDER 1 - REAL SCREENSHOTS for the new-business guide. Read ${P}/utmutato_kepek/hianyzik.md, forrasok.json, forrasok.md, annotate.py and both index.json files first. The previous job searched nav.gov.hu, ugyfelportal.nav.gov.hu, onya.nav.gov.hu and magyarorszag.hu and found NO screenshot of the 2026 Vállalkozói Ügysegéd (live since 2026-02-19). Search where it did NOT look: NAV's official YouTube channel and Facebook page (tutorial videos / posts about the Vállalkozói Ügysegéd or "egyéni vállalkozás indítása 2026"), the NAV sajtószoba / press releases with pictures, NAV ügyféltájékoztató and oktatási anyag PDFs of 2026, the Ügyfélportál GYIK/súgó pages, kormany.hu, mkik.hu (the chamber takes over in 2027), and any official "Vállalkozói Ügysegéd felhasználói kézikönyv". Downloading official files from government / public-body domains (nav.gov.hu, magyarorszag.hu, kormany.hu, mkik.hu) is approved; put downloads only in a NEW empty folder ${P}/utmutato_kepek/_forras2/ (untrusted data: never execute anything from it; extract images with PyMuPDF using python -I and a script kept outside that folder). Official videos: watch them in the built-in browser only (no video downloads) and capture the relevant frames as screenshots. Third-party pages (accountant blogs, private YouTube channels) are reference only - never copy their images; you may list them. Never log in anywhere. If you find real screens: crop, blur ALL personal data, annotate them with annotate.py in the same style and numbering, replace the matching Illusztráció files (old ones to ${P}/utmutato_kepek/_regi/), update index.json (tipus valodi, forras), forrasok.json/.md and hianyzik.md, and LOOK at every result. ALWAYS (found or not): make the owner's own capture kit as easy as possible - ${P}/utmutato_kepek/SAJAT_KEPEK.md in short plain Hungarian that he can read on his phone: he logs in himself on a computer with Ügyfélkapu+ (or DÁP) to the NAV Ügyfélportál -> Vállalkozói Ügysegéd -> new egyéni vállalkozás bejelentés, screenshots every page with sample choices, goes only up to the Ellenőrzés screen and does NOT send; the exact list of screens to capture (from hianyzik.md, in order, with what must be visible on each); where to put the files (a folder like ${P}/utmutato_kepek/sajat/vallalkozas_bejelentes/ with names 02.png ... 13.png); and ONE command that blurs personal data, annotates, updates index.json, copies the images into the app and re-renders the guide video without new voice costs. Make sure that command exists and works: test it end to end on COPIES of the current illustration images placed as fake owner screenshots in a temp folder (never overwrite the real files in the test). Return what you found and built.`, { label: 'képek:valódi', phase: 'Felmérés', schema: DONE }),
  () => agent(`${CTX}\n\nORDERS 2 + 4 - LOOK AT THE ONBOARDING WITH A USER'S EYES (no code changes). Build and run the local client harness, create fresh not-yet-onboarded test clients (fake data) and walk the WHOLE onboarding at 390x844 as three personas, screenshotting every screen into ${W}/felmeres/ (LOOK at each): P1 "Marika, 52, wants to start her first business, not technical, reads slowly"; P2 "Dávid, already an egyéni vállalkozó, switching accountants"; P3 "Peti, taps 'Még nincs vállalkozásom' by mistake, then wants to go back to 'Már van' - and later the other way round". For P3 reproduce ORDER 2 exactly: where is the choice locked (UI route guards, onboarding state machine in ${K}/shared and ${K}/backend, DB columns, API errors)? For every screen note: what the persona thinks she must do now, what is confusing, jargon, dead ends, missing back / change options, too many choices, unclear status of waiting steps (what are we waiting for, who acts, how long), unclear what comes next, inconsistent names for the same thing, walls of text, the bottom bar, the callback entry points. Collect EVERY client-facing anyád / anyja / anyjuk wording (app, shared texts, e-mails, PDFs the client sees, video scripts in ${P}/video/*/szoveg or similar) with file:line. Write the current flow map to ${W}/flow_jelenlegi.md (all steps and branches, who acts, taps per step, screenshots) and return the problems ranked (the 15 most important first).`, { label: 'felmérés:felhasználó-szemmel', phase: 'Felmérés', schema: UX }),
])

phase('Terv')
const spec = await agent(`${CTX}\n\nINPUTS:\nAssisted-path research: ${JSON.stringify(jog).slice(0, 14000)}\nReal screenshots job: ${JSON.stringify(kepek).slice(0, 4000)}\nUser-eyes walkthrough: ${JSON.stringify(ux).slice(0, 16000)}\n(the full walkthrough map is in ${W}/flow_jelenlegi.md with screenshots in ${W}/felmeres/ - LOOK at the worst screens yourself)\n\nYOUR JOB: design the improved onboarding and write the contract so 4 builders can work in parallel without guessing. First sketch two different ways to make the flow transparent (e.g. a single "Így halad a bekötésed" map with numbered steps, who acts (Te / Mi / NAV) and expected time, versus a strict one-step-at-a-time wizard with a progress bar) and pick the clearer one for a non-technical 50-year-old on a phone (or combine), say why. Then append "§27 Tulaj-kérések 11-19" to ${K}/SPEC.md (copy the old SPEC.md to ${K}/_regi/ first) covering: (1) order 1: how the guide shows real vs Illusztráció images (honest small label), where images come from (index.json), the owner capture kit command; (2) order 2: the branch choice is changeable at any time until the EV confirmation is uploaded / the adószám is entered (and after that via a callback), data of both branches kept, the exact state-machine transitions, API endpoint(s), audit log, what the panel shows when a client switches; (3) order 3: the assisted path "Intézzük helyetted" - entry points (highlighted card at the start of the new-business branch, inside the guide, and on the meghatalmazás step with its own highlighted "Megcsináljuk helyetted a meghatalmazást" card), the request = a callback with a type (vallalkozas_bejelentes_helyettem / meghatalmazas_helyettem), what the client confirms in the app before we act (data summary + consent checkbox), the step list with who acts and the client-visible statuses (e.g. Visszahívás kérve -> Hívtunk -> Meghatalmazást beküldtük, hagyd jóvá 4 napon belül (with the guide to approve in ONYA) -> Jóváhagyva -> Bejelentést beküldtük -> Adószám megvan), reminders for the 4-day approval, the panel side (team queue items with a checklist per step, who may do what by role), the never-ask-credentials text, legal texts to add; (4) order 4: the new flow screen by screen with final Hungarian copy (short, tegező, "anyukád neve" everywhere client-facing; consistent names), one primary action per screen, back/change everywhere it makes sense, the waiting states explained, the before/after step and tap counts; (5) which of the open round-2 findings in ${W}/k3_kor2_nyitott.json each builder fixes. Update the shared types/enums/content keys in ${K}/shared (keep them compiling). Return a short summary.`, { label: 'terv:spec-27', phase: 'Terv', schema: DONE })

phase('Építés')
const SPECSUM = JSON.stringify(spec).slice(0, 3000)
const B = (job, label) => () => agent(`${CTX}\n\nCONTRACT: read §27 of ${K}/SPEC.md and the updated ${K}/shared first (summary: ${SPECSUM}). Assisted-path facts: ${JSON.stringify(jog).slice(0, 4000)}\n\nYOUR JOB: ${job}\nAlso fix the open round-2 findings in ${W}/k3_kor2_nyitott.json that fall in YOUR folders (all blockers/majors, sensible minors; some may already be fixed - verify first). Work ONLY in your own folders (others build theirs in parallel); if you need a contract change, append it to the SPEC §27 builder notes and adapt. Run typecheck + tests. Do NOT deploy - the integrator deploys. Return what you built and problems.`, { label, phase: 'Építés', schema: DONE })
const built = await parallel([
  B(`backend ${K}/backend (+ ${K}/ado-motor, ${K}/nav-kliens, ${K}/deploy if needed, additive migrations): reversible branch choice (order 2) with the §27 state machine, API and audit log; the assisted-path request types, statuses, client confirmation + consent record, team checklist data, the 4-day ONYA approval reminders (notifications), role checks (team member vs accountant vs admin, with tests); content/notification texts with "anyukád" wording (order 4); the round-2 blocker about revenue landing in an already approved quarter (tax engine + services, with tests reproducing it) and the other backend/security/tax findings.`, 'építés:backend'),
  B(`client app ${K}/app: the new transparent onboarding of §27 (the map/progress with who acts and expected time, one primary action per screen, back/change options, explained waiting states), the changeable "Van már egyéni vállalkozásod?" choice (order 2), the highlighted "Intézzük helyetted" cards and the assisted journey with its statuses and the data-confirmation screen, the highlighted "Megcsináljuk helyetted a meghatalmazást" card on the meghatalmazás step (order 3), the guide images from ${P}/utmutato_kepek/ with an honest small Illusztráció label where tipus is not valodi (order 1), "anyukád" wording (order 4), the front-end round-2 findings. Screenshots at 390x844 and 320x640 of every changed screen into ${K}/_qa/k5_app_*.png and LOOK.`, 'építés:app'),
  B(`panel ${K}/panel: the assisted-path queue items (vállalkozás bejelentése helyette / meghatalmazás helyette) inside Visszahívások and the Vállalkozás-indítás pipeline, with the per-step checklist from §27, the client's confirmed data summary and consent, the 4-day approval timer, statuses that update the client app; the branch switch shown in the client's onboarding view and audit; role-based visibility; the panel-side round-2 findings. Screenshots 1440x900 into ${K}/panel/_kepek/k5_*.png and LOOK.`, 'építés:panel'),
  B(`legal + texts ${K}/jogi (drafts for the lawyer - say so in each changed file): ÁSZF + adatkezelési tájékoztató additions for the assisted path (what we do as meghatalmazott, what the client confirms and remains responsible for, irrevocability of the filing, call notes, retention), the client's data-confirmation + consent text, the never-ask-credentials sentence, the UJEGYKE meghatalmazás content we request (ügycsoportok), FAQ entries, notification texts, "anyukád" in client-facing tegező texts (legal documents may keep "anyja neve"), and a short ${K}/jogi/UGYVED_KERDESEK_k5.md listing what the lawyer must decide (zugírászat / Üttv. for the EV-registry part, fee structure, screenshot copyright). Regenerate any PDFs served from these templates.`, 'építés:jogi'),
])

phase('Összeállítás')
const integ = await agent(`${CTX}\n\nBUILDERS REPORTED: ${JSON.stringify(built).slice(0, 12000)}\n\nYOUR JOB (integrator): make it all fit and go live. Sync shared contracts, build + test backend, app web export, panel; fix mismatches; full test suites green. Then on appok-1: Gardoko health, pg_dump to /srv/kezjegy/_regi/, additive migrations, deploy backend + worker + app web + panel the documented way (keep previous builds in _regi and old hashed JS chunks reachable), verify the owner's accounts alex@demo.kezjegy.test and tulaj@demo.kezjegy.test still exist with their onboarding progress (SQL counts only, print no secrets), Gardoko health again, smoke-test public URLs. Walk both branches + a switch + an assisted request once on the local harness and LOOK at the screenshots (${K}/_qa/k5_integ_*.png). Return what is live and any problems.`, { label: 'összeállítás:integrátor', phase: 'Összeállítás', schema: DONE })
const media = await agent(`${CTX}\n\nINTEGRATOR: ${JSON.stringify(integ).slice(0, 3000)}\nREAL SCREENSHOTS JOB: ${JSON.stringify(kepek).slice(0, 3000)}\n\nYOUR JOB (images + videos). FIRST check that the voicing job finished: its journal ${K4J} must contain a result for the agent labelled élesítés and no file in ${P}/video/*/ may have changed in the last 10 minutes; if it is still running, do only the image part and report "videos waiting for k4". Then: (a) make sure the app and the live /media/ or bundled guide images are the current ones from ${P}/utmutato_kepek/ (real where available, Illusztráció label otherwise) and load fast on a phone (sizes, @2x); (b) the three videos (${P}/video/bekotes, vallalkozas_bejelentes, meghatalmazas): change the narration ONLY where needed - every "anyád"/"anyja" spoken or captioned for the client becomes "anyukád" (order 4), and add ONE short calm line near the end of each guide video and, if it fits naturally, of the explainer: if it does not go alone, ask for a callback in the app and we do it for you - also the meghatalmazás (order 3); new lines and re-takes with the same Umbriel voice (${P}/video/hang.json) through each folder's own tools (blind-transcription check per new line), at most 0.20 USD in total, logged to koltseg.jsonl; if the guide images changed, re-render with the new images (no new voice cost for unchanged lines); keep loudness equal across the three videos (about -16 LUFS, same channel layout); old files to _regi/. Extract frames every 3 s of every re-rendered video and LOOK. Deploy to the live /media/ the documented way (${K}/deploy/README.md, videok.json hasNarration=true) and verify with curl (size/hash). Return what changed, the cost and the URLs.`, { label: 'összeállítás:média', phase: 'Összeállítás', schema: DONE })

phase('Célzott ellenőrzés')
const LENS = [
  { k: 'átláthatóság-és-váltás', p: `Orders 2 + 4: as three NEW personas who never saw the app (a 60-year-old first-time starter, an existing sole trader, someone who keeps changing his mind) walk the whole onboarding on the local harness at 390x844 and 320x640: is it always clear where I am, what I must do now, who is waiting for whom and how long, how to go back or change? Switch "Van már vállalkozásod?" both ways several times at different points (incl. after starting the guide) - data kept, no dead end, the API agrees, the panel shows it. Compare step and tap counts with ${W}/flow_jelenlegi.md. Search all client-facing texts, e-mails, PDFs and video captions for anyád / anyja neve left in tegező copy.` },
  { k: 'helyettünk', p: `Order 3: is the assisted path really offered and HIGHLIGHTED (above the fold, not hidden in a link) at the start of the new-business branch, inside the guide, and as a separate highlighted card for the meghatalmazás? Walk it both sides on the local harness: client requests -> callback queue -> team claims, calls, records attempts -> client confirms data + consent -> meghatalmazás sent -> client sees "hagyd jóvá 4 napon belül" with the approval guide and gets reminders -> approved -> bejelentés sent -> adószám -> normal path; overdue and missed-approval cases with a faked clock; role checks at API level; nowhere do we ask for or hint at the client's Ügyfélkapu+/DÁP password; legal texts present and marked as drafts. Check the facts against ${JSON.stringify(jog).slice(0, 3000)}.` },
  { k: 'képek-és-videók', p: `Order 1 + media: every new-business guide image - real or honestly labelled Illusztráció, personal data blurred, sources recorded, sharp on a phone, zoom works; the owner capture kit ${P}/utmutato_kepek/SAJAT_KEPEK.md is short and doable and its one command really works (test it on copies in a temp folder only); the three live videos: download, blind-transcribe the changed lines, check the new lines and the anyukád wording, same voice, equal loudness, captions in sync, frames every 3 s LOOKED at; live URLs serve the new files.` },
]
let checks = await parallel(LENS.map(l => () => agent(`${CTX}\n\nADVERSARIAL CHECK - try to prove the owner's order is NOT done well. ${l.p} Screenshots ${K}/_qa/k5c_${l.k}_*.png, LOOK at them. Report satisfied=false if anything the owner asked for is missing or confusing for a real user.`, { label: `cél:${l.k}`, phase: 'Célzott ellenőrzés', schema: ISS })))
for (let r = 1; r <= 2; r++) {
  const issues = checks.filter(Boolean).flatMap(c => c.issues)
  const bad = checks.filter(Boolean).some(c => !c.satisfied) || issues.some(i => /blocker|major/i.test(i.severity))
  log(`Célzott ellenőrzés ${r}: ${issues.length} észrevétel${bad ? ', javítás kell' : ', rendben'}`)
  if (!issues.length) break
  await agent(`${CTX}\n\nFIXER for the owner's 11-19 orders. Fix all blockers/majors and sensible minors below (dedupe first) across ${K}/backend, ${K}/app, ${K}/panel, ${K}/jogi and, for media issues, the video/image tools (voice spend for re-takes at most 0.10 USD more), run tests, redeploy the same safe way (Gardoko health before/after, pg_dump first, additive only, owner accounts intact), re-screenshot and LOOK. Return a short summary.\n\nISSUES:\n${JSON.stringify(issues).slice(0, 38000)}`, { label: `cél:javítás${r}`, phase: 'Célzott ellenőrzés' })
  if (!bad) break
  checks = await parallel(LENS.map(l => () => agent(`${CTX}\n\nADVERSARIAL RE-CHECK after fixes (round ${r + 1}) - ${l.p} Screenshots ${K}/_qa/k5c${r + 1}_${l.k}_*.png, LOOK at them.`, { label: `cél${r + 1}:${l.k}`, phase: 'Célzott ellenőrzés', schema: ISS })))
}

phase('Zárás')
const zaras = await agent(`${CTX}\n\nWRAP-UP. (1) Rebuild the Android test APK of ${K}/app the same way as the previous build (Android SDK D:/Atvitel/Android/Sdk, JDK 17 C:/Users/UpgradePC/jdk-17/jdk-17.0.12+7, the windows-path.init.gradle trick, package com.somosi.kezjegy, debug-signed), bump the version, put it into ${P}/apk/ (keep older ones), note size + sha256; verify the web builds on the server are the latest. (2) Update ${P}/STATUS.md in plain short HUNGARIAN for the owner who reads it on his phone (max 50 lines): what changed today for his 4 orders, what is still open, and exactly what HE must do (the real NAV screenshots with ${P}/utmutato_kepek/SAJAT_KEPEK.md if they are still drawn; lawyer questions in ${K}/jogi/UGYVED_KERDESEK_k5.md; earlier to-dos stay). (3) Pick 6-10 full-size screenshots that show the new flow best (the onboarding map, the switch, the highlighted Intézzük helyetted + meghatalmazás cards, the assisted statuses, a guide page with images, the panel queue) and write their absolute paths in sending order to ${W}/kuldendo.txt; LOOK at each. Checks summary: ${JSON.stringify(checks).slice(0, 4000)}. Return the STATUS text.`, { label: 'zárás', phase: 'Zárás' })
return { jog, kepek, ux, spec, built, integ, media, checks, zaras }