export const meta = {
  name: 'kezjegy-k3-tulaj-keresek',
  description: 'Owner change requests for the accountant app: new-business path, callback request instead of booking, bottom bar + restricted account during onboarding, what/why/where explainers on every onboarding step, a narrated onboarding explainer video (Gemini 3.8 TTS via OpenRouter); research, spec, parallel build, deploy, targeted adversarial checks, then the full verification rounds',
  phases: [
    { title: 'Kutatás', detail: 'official EV registration process, callback UX' },
    { title: 'Terv', detail: 'spec addendum + shared contracts; annotated NAV screenshots' },
    { title: 'Építés', detail: 'backend, app, panel, legal texts, explainer video in parallel' },
    { title: 'Összeállítás', detail: 'integrate, migrate, deploy, demo data' },
    { title: 'Célzott ellenőrzés', detail: 'adversarial check of the 3 owner requests, fix' },
  ],
}

const P = 'C:/Users/UpgradePC/konyvelo_app'
const K = `${P}/kod`
const D = `${P}/dizajn/C2_modern`
const HOST = '45-94-65-74.sslip.io'
const CTX = `PROJECT: "Kézjegy" (working name; the name lives only in ${K}/shared/brand.json) - a Hungarian service: alanyi-ÁFA-mentes, átalányadós sole traders (egyéni vállalkozók) get a real human accountant for 20 000 Ft gross/month, sold by Somosi Kft.; the accountant (demo: "Kovács Bence") is a subcontractor and the NAV meghatalmazott. The system is BUILT and LIVE: client app ${K}/app (Expo + expo-router; web https://app.${HOST}), accountant + admin panel ${K}/panel (https://konyvelo.${HOST}), backend ${K}/backend (Hono + Drizzle + Postgres; https://api.${HOST}), tax engine ${K}/ado-motor, NAV client ${K}/nav-kliens, legal drafts ${K}/jogi, deploy ${K}/deploy, shared contracts ${K}/shared (sync with its scripts/sync-shared.mjs). Read ${K}/SPEC.md (esp. §24 builder notes), ${P}/FUNKCIOK.md, ${P}/STATUS.md and the READMEs of the folders you touch BEFORE changing anything.
APPROVED DESIGN (keep it): ${D}/app_v2/*.png + TERV.md - Geist, ink-blue header band, white sheets on tinted ground; realistic 3D icons from ${D}/assets/ikon3d (NO line/vector icons anywhere, NO pastel circles); the drawn character avatar ${D}/assets/avatar/karakter_1_lapos*; realistic object visuals ${D}/assets/illusztraciok. New screens must look like they belong to the approved set.
SERVER: ssh alias appok-1; this project in /srv/kezjegy (own compose + Postgres); Caddy is shared with the Gardoko app, which MUST keep working (check https://${HOST}/api/v1/health before and after every deploy; copy shared files to /srv/appok/_regi/ before changing them). THE LIVE DATABASE MUST NEVER BE WIPED OR RESEEDED: the owner is using it right now with his own registered client account (alex@demo.kezjegy.test, mid-onboarding) and a prepared account tulaj@demo.kezjegy.test - both, and their progress, must survive every migration and deploy. Migrations are additive (rename = add + copy + keep old); take a pg_dump into /srv/kezjegy/_regi/ before migrating. Demo logins live only in /srv/kezjegy/demo_belepesek.txt and /srv/kezjegy/tulaj_demo_belepes.txt (never print them).
TESTING: never type passwords on the live host (it is not a local/test host). Logged-in journeys run on the LOCAL harnesses with the demo seed: client app (npm run build in ${K}/backend, npm run export:web in ${K}/app, then node scripts/helyi-proba.mjs -> http://127.0.0.1:8791, /__helyi/belep?ki=kata logs in a seed user; see ${K}/app/README.md); panel (npm run dev in ${K}/panel -> http://localhost:5174 proxied to a local backend, or npm run dev:mock; see ${K}/panel/README.md). Use your own ports if one is taken. LOOK at every screenshot you take (headless Chrome, unique --user-data-dir per shot, forward-slash paths).
RULES: never delete files (move to _regi/), never print or commit secrets or demo passwords, no logins or accounts on external services, never touch vett.hu, only fake data. Hungarian UI copy with tegeződés, plain short words, no AI mentioned anywhere in public texts.

THE OWNER'S NEW ORDERS (his words, 11-18 08:24, translated):
1) "When people enter their data, let's make it possible to START NEW businesses too: they give the data that is needed, we call them and confirm it. We register (bejelentjük) the business if they don't have one yet."
2) "Do not let people pick a time slot for a video/phone call; instead they REQUEST A CALLBACK and a colleague will call them within 24-48 hours. It will not necessarily be the accountant personally first, but someone from our team."
3) "The bottom bar disappeared" - during onboarding (bekötés) the app shows no bottom tab bar. Decision: show a bottom bar during onboarding too, at least Főoldal (the onboarding checklist), Üzenetek and Fiók, so a new client can write to us and reach account/logout; tabs that only make sense after onboarding either stay hidden or show a short friendly explanation.
4) (08:45) "Until the account is connected (bekötve), some functions should be LIMITED in the account." -> a clear restricted mode before activation: what stays usable (onboarding, messages, account/logout/delete/export, FAQ, callback) and what is locked with a short reason ("a bekötés után nyílik meg"), enforced in the API too, not only hidden in the UI.
5) (08:45) "On the onboarding page there should be an EXPLAINER VIDEO and everything written down: what is needed, why, and WHERE to find it." -> every onboarding item gets a short "Mi ez? Miért kell? Hol találod?" explainer (e.g. adóazonosító jel on the adókártya, TAJ on the TAJ-kártya, adószám, ÖVTJ codes, Ügyfélkapu+ / DÁP mobile app, where to click for the NAV meghatalmazás, what photo of the ID card we need), plus the video at the top of the onboarding page.
6) (08:50) The video, in the owner's words: "Thank you for installing our app (Köszönjük, hogy telepítetted az alkalmazásunkat), then first say what this app is good for, then the onboarding process, what is needed for what, etc." Voice: Gemini 3.8 TTS through OpenRouter (the owner asked for it explicitly).`

const CTX2 = `${CTX}
7) (09:40) THE OWNER CHANGED ORDER 1 after reading the research ("az ügyfél adja be, mi telefonon végigvezetjük"): "Then there is not much point if we guide them by phone - we need a GUIDE so the client can submit it himself." So the new-business path is SELF-SERVICE: a personalised step-by-step in-app guide ("Mit hova jelölj", built from the client's answers: which screen, which field, what to tick - above all alanyi ÁFA-mentesség IGEN, átalányadózás IGEN, kata NEM, pénzforgalmi NEM, the right munkavégzés jellege), with clear pictures (REAL annotated NAV screenshots - see order 9), the explainer video and a checklist; the client files the EV bejelentés himself (Ügyfélkapu+ or DÁP, NAV Vállalkozói Ügysegéd), uploads the confirmation PDF, then files the NAV meghatalmazás for the accountant himself with the same kind of guide (the ONYA/UJEGYKE path where the client is the meghatalmazó). NO mandatory phone call anywhere: "Elakadtál? Kérj visszahívást" (order 2) stays as OPTIONAL help on every step. The team only checks the uploaded confirmation and the data (no team filing on the client's behalf). Also fix the KYC step: never ask for a photo of the back of the lakcímkártya (Pmt. 7. § (8) a) - it carries the personal identifier).
8) (09:50) "Videó is lesz hozzá!" - the self-service guides get their OWN short narrated videos too, in the same voice and style as the main video: /media/vallalkozas_bejelentes.mp4 (how to fill in the EV bejelentés in the NAV Vállalkozói Ügysegéd, screen by screen on our drawn schematic screens: what to tick and why, the Ellenőrzés screen before sending, uploading the confirmation) and /media/meghatalmazas.mp4 (how the client gives the NAV meghatalmazás to the accountant himself, step by step), each with poster + vtt, embedded at the top of its guide. The "Készítsd elő" list (személyi, lakcímkártya, adókártya/adóazonosító jel, TAJ-kártya, anyja neve, születési adatok, székhely jogcíme, ÖVTJ) opens the new-business guide; we do not store TAJ or anyja neve - the client types them into the NAV form himself.
9) (10:00) "NAV screenshots with markings are needed" - the guides and the guide videos use REAL screenshots of the NAV screens, annotated (numbered markers, highlight boxes, short arrows in the C2 colours, personal data blurred, source noted). They come from the 'NAV-képek' job into ${P}/utmutato_kepek/<guide>/ with an index.json (step -> image, what to set, caption, source); a drawn reconstruction labelled "Illusztráció" only where no official screenshot exists. Nobody of us logs in to NAV/Ügyfélkapu: missing screens are listed for the owner to capture himself later and re-annotate with one command.
NOTE: an earlier run of this job was stopped while writing SPEC §26 - if a partial §26 or partial shared types exist, replace them cleanly.`

const DONE = { type: 'object', properties: { done: { type: 'array', items: { type: 'string' } }, files: { type: 'array', items: { type: 'string' } }, owner_todo: { type: 'array', items: { type: 'string' } }, problems: { type: 'array', items: { type: 'string' } } }, required: ['done', 'files', 'owner_todo', 'problems'] }
const RES = { type: 'object', properties: { findings: { type: 'array', items: { type: 'object', properties: { topic: { type: 'string' }, fact: { type: 'string' }, source: { type: 'string' }, certainty: { type: 'string', description: 'official|secondary|uncertain' } }, required: ['topic', 'fact', 'source', 'certainty'] } }, recommendation: { type: 'string' }, open_questions: { type: 'array', items: { type: 'string' } } }, required: ['findings', 'recommendation', 'open_questions'] }
const ISS = { type: 'object', properties: { satisfied: { type: 'boolean' }, issues: { type: 'array', items: { type: 'object', properties: { severity: { type: 'string', description: 'blocker|major|minor' }, area: { type: 'string', description: 'app|panel|backend|jogi|deploy' }, where: { type: 'string' }, what: { type: 'string' }, fix: { type: 'string' } }, required: ['severity', 'area', 'where', 'what'] } }, checked: { type: 'array', items: { type: 'string' } } }, required: ['satisfied', 'issues', 'checked'] }

phase('Kutatás')
const [evKut, hivKut] = await parallel([
  () => agent(`${CTX}\n\nRESEARCH (no code changes): how a NEW egyéni vállalkozás is registered in Hungary in 2026, from OFFICIAL sources (magyarorszag.hu / Webes Ügysegéd "Egyéni vállalkozói tevékenység bejelentése" (EVNY), NAV, the Evectv. 2009. évi CXV., the Szja tv. átalányadó rules, kormányhivatal pages, the kamara). Find: (a) the complete list of data the bejelentés asks for (personal data incl. születési név, anyja neve, születési hely/idő, állampolgárság, lakcím, adóazonosító jel, TAJ if asked; ÖVTJ tevékenységek + főtevékenység; székhely/telephely/fióktelep and the right to use it; start date; contact; adózási mód: átalányadó election and alanyi ÁFA-mentesség election at registration; employment; mellékállás / nyugdíjas status; anything else), (b) WHO may file it: the client himself (Ügyfélkapu+/DÁP), or a representative - exactly what authorisation a representative needs now that AVDH is gone (Rendelkezési Nyilvántartás eseti/állandó meghatalmazás? written meghatalmazás? which ügytípus), and whether a company's employee or the accountant may do it, (c) what happens automatically afterwards (adószám, statisztikai számjel, NAV/TB/kamara notifications) and how long it takes, (d) fees, (e) activities needing qualifications or permits, székhely documents, the kamarai hozzájárulás, (f) pitfalls for átalányadó + alanyi ÁFA-mentes starters (e.g. mid-year start limits are prorated, the first-year rules), (g) GDPR notes for collecting this data. Then recommend the safest flow for OUR service: we collect the data in the app, a team member calls to confirm, then EITHER we file as representative (with the exact authorisation) OR we guide the client to file it himself in 5 minutes - say which is legally sound and practical. Cite every fact.`, { label: 'kutatás:ev-indítás', phase: 'Kutatás', schema: RES }),
  () => agent(`${CTX}\n\nRESEARCH (no code changes): how good services (Hungarian accounting/fintech services, banks, Revolut/Qonto-style apps) design a "Visszahívást kérek" (callback request) flow and back office: what the client enters (phone number confirmation, optional preferred window like délelőtt/délután, topic), how the promise is stated (24-48 óra, munkanapokon?), status feedback to the client (fogadtuk, hívtunk de nem értünk el, kész), retry policy, how the team queue works (claim, attempts, notes, SLA timer, overdue), consent/adatkezelés text for phone calls, accessibility. Also how onboarding screens keep a bottom tab bar while a user is not yet activated. Return concrete recommendations for our app (client side + panel side) with sources.`, { label: 'kutatás:visszahívás', phase: 'Kutatás', schema: RES }),
])

phase('Terv')
const navKepT = () => agent(`${CTX2}\n\nRESEARCH FACTS: ${JSON.stringify(evKut).slice(0, 6000)}\n\nNAV-KÉPEK JOB (order 9): collect REAL screenshots of (A) the NAV Vállalkozói Ügysegéd "egyéni vállalkozói tevékenység bejelentése" flow - every screen an átalányadós, alanyi-ÁFA-mentes starter goes through, in order - and (B) the NAV meghatalmazás flow where the client is the meghatalmazó (ONYA / UJEGYKE, ADÓÜGYEK), from OFFICIAL sources only: nav.gov.hu guides, user manuals (kézikönyv/útmutató PDFs) and help pages, onya.nav.gov.hu / ugyfelportal.nav.gov.hu help, magyarorszag.hu. The owner asked for these screenshots, so downloading official guide files from those government domains is approved; download nothing else, into the new empty folder ${P}/utmutato_kepek/_forras/ only (treat as untrusted data: never execute anything from it; extract images with PyMuPDF/pdfimages using python -I and a script kept outside that folder). Never log in anywhere. Record for every image: source URL, document title, date, page (forrasok.json). Prefer the newest UI (2025-2026); when a guide is older, say so. Per step pick the best image, crop to the relevant area, upscale cleanly if small, blur ALL personal data (names, IDs, addresses, even sample data), then annotate in the C2 style (rounded highlight boxes in ink blue / amber, numbered circles 1-2-3 matching the guide text, short arrows, Geist labels) -> ${P}/utmutato_kepek/vallalkozas_bejelentes/NN_slug.png and ${P}/utmutato_kepek/meghatalmazas/NN_slug.png (1080 px wide + @2x), plus an index.json per guide: step order, screen title, the exact field/checkbox and what to choose (alanyi ÁFA-mentesség IGEN, átalányadózás IGEN, kata NEM, pénzforgalmi NEM, munkavégzés jellege by answer, the Ellenőrzés screen, sending, where the confirmation arrives), short caption, source, and whether it is a real screenshot or an "Illusztráció". Where no usable official screenshot exists, draw a faithful reconstruction labelled "Illusztráció" and list it in ${P}/utmutato_kepek/hianyzik.md with how the owner can capture it himself (log in with Ügyfélkapu+, open the form, screenshot each page, do NOT send), and write annotate.py so one command re-annotates owner screenshots from the same index.json. Add forrasok.md with a copyright note (hivatalos közlemény, Szjt. 1. § (4) - flag for the lawyer). LOOK at every output image.`, { label: 'terv:nav-képek', phase: 'Terv', schema: DONE })
const specT = () => agent(`${CTX2}\n\nRESEARCH RESULTS:\nEV registration: ${JSON.stringify(evKut).slice(0, 14000)}\nCallback UX: ${JSON.stringify(hivKut).slice(0, 6000)}\n\nYOUR JOB: write the contract for the 3 owner orders so 4 builders can work in parallel without guessing. Append a new section "§26 Tulaj-kérések 11-18" to ${K}/SPEC.md (copy the old SPEC.md to ${K}/_regi/ first) covering: (1) onboarding branch at the start of the data step: "Van már egyéni vállalkozásod?" -> existing path unchanged / "Még nincs, most indítanám" -> the new-business data form (fields from the research, grouped into short pages, with validation rules, ÖVTJ search with the common activities of our target group, cost-ratio hint from ado-motor) -> the personalised self-service filing guide (order 7) -> the client files the bejelentés himself and uploads the confirmation PDF -> the team checks it -> the adószám arrives -> the normal path continues (NAV meghatalmazás for the accountant, ID, NAV bekötés); the new onboarding step(s) and their statuses; when the subscription is charged for someone whose business does not exist yet (propose a default, mark it as an owner decision); (2) the callback request replacing the appointment booking EVERYWHERE (onboarding step, accountant card, messages, settings, FAQ texts, notifications): data model (additive migration; keep old appointment rows and the old 'idopont' step readable - map them), statuses, SLA (due = +48 h, overdue), attempts and notes, who handles it: a new staff role for the team (e.g. 'csapat' / ügyfélszolgálat, minimal permissions: callbacks + new-business requests + messages of clients in onboarding, no tax approval) plus admin, optional assignment to the accountant, client-side status texts; (3) the bottom tab bar during onboarding (which tabs, what each shows before activation); (4) panel pages: Visszahívások queue, Vállalkozás-indítás pipeline (data review, guide opened, client reports filed + confirmation PDF, checked by the team, adószám received), staff management for the new role in admin; (5) API endpoints with request/response shapes and roles; the restricted-account matrix before activation (order 4: each feature -> allowed/locked + reason, enforced server-side); the explainer content for every onboarding item (order 5: Mi ez? / Miért kell? / Hol találod? texts in Hungarian, served as editable content texts, with which 3D icon or object visual goes with each); the video contract (orders 5/6: served from the client web origin at /media/bekotes.mp4 + /media/bekotes_poszter.jpg + /media/bekotes.vtt, player behaviour, where it sits on the onboarding page, works in the APK by streaming from https://app.${HOST}/media/... with a graceful placeholder if missing; the same contract for the two guide videos of order 8: /media/vallalkozas_bejelentes.* and /media/meghatalmazas.*); put the new DTOs/enums into ${K}/shared/src (api.ts, enums.ts) and run its typecheck + sync; (6) notifications and e-mail texts; (7) legal text changes needed in ${K}/jogi (ÁSZF service scope for business registration, adatkezelés for the new data categories and phone calls, the authorisation template the research recommends); (8) demo data to ADD to the live DB without reseeding (one demo client in the new-business state, 2-3 callback requests in different states, one team-member account whose password goes only into /srv/kezjegy/demo_belepesek.txt) as an idempotent script; (9) acceptance tests for each order. Also update ${P}/FUNKCIOK.md (copy the old one to ${P}/_regi/ first): point 6 becomes the callback request, point 26 the callback queue, add the new-business points. Do not build features yourself beyond the shared contracts.`, { label: 'terv:spec-26', phase: 'Terv', schema: DONE })
const [spec, navKep] = await parallel([specT, navKepT])

phase('Építés')
const SPECSUM = JSON.stringify(spec).slice(0, 3000)
const B = (job, label) => () => agent(`${CTX2}\n\nCONTRACT: read §26 of ${K}/SPEC.md and the updated ${K}/shared first (spec summary: ${SPECSUM}). EV registration facts: ${JSON.stringify(evKut).slice(0, 5000)}\nNAV screenshots (order 9): ${JSON.stringify(navKep).slice(0, 2500)}\n\nYOUR JOB: ${job}\nWork ONLY in your own folder (others are building theirs in parallel); if you need a contract change, append it to SPEC §24 builder notes and adapt. Run typecheck + tests. Return what you built and problems.`, { label, phase: 'Építés', schema: DONE })
const built = await parallel([
  B(`backend ${K}/backend (+ migrations, + ${K}/deploy if needed): the new onboarding branch and steps, the new-business request model + endpoints, the callback request model + endpoints + SLA/overdue job + notifications, the new staff role with strict permission checks (and tests proving a team member cannot approve taxes or read other areas), the server-side restricted-account checks before activation (order 4, with tests), the explainer content texts (order 5), mapping of old appointment data, the idempotent demo-data addition script (never reseed), audit log entries. Do NOT deploy - the integrator deploys.`, 'építés:backend'),
  B(`client app ${K}/app: the "Van már egyéni vállalkozásod?" branch and the new-business data pages (short, friendly, validated, ÖVTJ search, the personalised "Mit hova jelölj" self-service guide built on the annotated NAV screenshots from ${P}/utmutato_kepek/ (index.json; bundle or serve them per SPEC §26, zoomable full-screen on tap) and a progress checklist, upload of the confirmation PDF, the same kind of guide for the client's own NAV meghatalmazás, optional "Elakadtál? Kérj visszahívást" on every step; no ID-card back side photo (order 7)), the callback request flow replacing every appointment/time-slot UI (phone number confirm, optional window, status card: "Kollégánk 24–48 órán belül hív", attempts/kész states), the accountant card text no longer promising Bence personally for the first call, the bottom tab bar during onboarding per §26, the restricted-account mode (locked tabs/actions with a short reason, order 4), the "Mi ez? / Miért kell? / Hol találod?" explainer on every onboarding item (order 5, expandable, readable for a 60-year-old), the explainer video card at the top of the onboarding page and the two guide videos at the top of their guides (order 8; poster, play, fullscreen, captions, mute-safe, placeholder when the file is missing; expo-video on native, <video> on web), all with 3D icons and the C2 look. Screenshots at 390x844 and 360x780 on the local harness into ${K}/app/_kepek/k3_*.png and LOOK at them.`, 'építés:app'),
  B(`panel ${K}/panel: Visszahívások queue (claim, call attempts with outcome, notes, SLA timer, overdue highlight, filters), Vállalkozás-indítás pipeline per client (data review with edit, the client's uploaded confirmation PDF to check, "ellenőrizve", adószám entry that unlocks the normal path - the team does not file for the client), the new team role's navigation (only what it may see), admin staff management for the role, removal of the old Időpontok page from navigation (move code to _regi or keep behind a flag). Desktop screenshots 1440x900 into ${K}/panel/_kepek/k3_*.png and LOOK.`, 'építés:panel'),
  B(`explainer VIDEO for the onboarding page (orders 5 and 6). Work in ${P}/video/bekotes/ (new folder). (a) Script in Hungarian, tegeződés, warm and calm private-bank tone, 70-110 s: "Köszönjük, hogy telepítetted az alkalmazásunkat" -> what the app is good for (a real accountant does your taxes, NAV invoices arrive by themselves, you see what to pay and when, you just photograph receipts) -> the onboarding steps in order and what each is needed for, per SPEC §26 (both branches: existing business, and "még nincs vállalkozásom" where the app gives you a step-by-step guide so you can register the business yourself in a few minutes; the NAV meghatalmazás you give the accountant yourself with the in-app guide, so he can file for you; ID photos because the law requires identification; if you get stuck, request a callback and our team calls you within 24-48 hours) -> what happens after. Do NOT say the product name or the accountant's name (both will change) - say "az alkalmazás", "a könyvelőd", "csapatunk"; never mention AI. Have the script checked by two independent reviewers (Hungarian language + factual match with SPEC §26 and FUNKCIOK) and revise. (b) Voice: Gemini 3.8 Flash TTS through OpenRouter - model google/gemini-3.8-flash-tts at https://openrouter.ai/api/v1/audio/speech; copy the proven request shape from D:/Atvitel/Desktop/kukutyini-studio/szinkron_kozos/tts_magyar_gemini.py (openrouter_jelenet; or_kulcs reads OPENROUTER_API_KEY from the Windows registry HKCU Environment inside the process only; never print it). The balance is only ~0.97 USD and you must not top it up: keep your spend under 0.30 USD, log every call with its cost to ${P}/video/bekotes/koltseg.jsonl, cache every take. First make three 8-10 s samples with different calm voices/styles, pick the clearest one for Hungarian and WRITE the choice (voice name + style instruction + request shape) to ${P}/video/hang.json at once - the guide-video builder working in parallel waits for that file so all videos share one voice. Your own budget is 0.30 USD of the 0.60 USD total. Then voice the script line by line (style instructions per line). Check pronunciation with a blind transcription of each line (reuse the idea of kukutyini-studio kiejtes_vak.py / sor_biro; Gemini 3.8 Flash can transcribe audio via OpenRouter cheaply) and re-take only wrong lines. If OpenRouter refuses (402 / minimum balance), stop the voice part, keep everything else ready with a one-command voice step, and report it. (c) Picture: motion design in the approved C2 style (ink-blue band, white sheets, Geist, the 3D icons from ${D}/assets/ikon3d, the character avatar, the object visuals) - prefer animated cards and icons over app screenshots so the video does not go stale when screens change; 1080x1920 vertical, 30 fps, large burned-in captions plus a WebVTT file, a soft music bed only if license-free (otherwise none). Use Remotion if it is set up on this machine (look for existing Remotion projects under D:/Atvitel/Desktop/kukutyini-studio) or ffmpeg + PIL frames. Read the name from ${K}/shared/brand.json only where a name must appear on screen, and keep a one-command re-render (render.md). (d) Output: ${P}/video/bekotes/bekotes.mp4 (H.264 + AAC, <= 15 MB), bekotes_poszter.jpg, bekotes.vtt, plus copies into the client web export's media folder per SPEC §26 for the integrator. Extract frames every 3 s and LOOK at them; fix anything ugly, cut off or off-brand.`, 'építés:videó'),
  B(`the two GUIDE VIDEOS of order 8, in ${P}/video/vallalkozas_bejelentes/ and ${P}/video/meghatalmazas/. Same rules and tools as the main explainer video being made in parallel in ${P}/video/bekotes/ (Hungarian, tegeződés, calm private-bank tone, no product or accountant name, never AI; script reviewed by two independent reviewers for language and for factual match with SPEC §26, the official NAV Vállalkozói Ügysegéd / ONYA-UJEGYKE steps and the research facts; 1080x1920 vertical, 30 fps, burned-in captions + WebVTT, C2 motion design built on the annotated REAL NAV screenshots from ${P}/utmutato_kepek/<guide>/ (index.json; slow zoom to each marked area, markers appearing in sync with the narration) - a drawn reconstruction only where the index says so; Remotion if available, else ffmpeg + PIL). Length: bejelentés 90-150 s (Készítsd elő list, belépés Ügyfélkapu+/DÁP, the screens in order with what to tick and why - alanyi ÁFA-mentesség IGEN, átalányadózás IGEN, kata NEM, pénzforgalmi NEM, munkavégzés jellege, the Ellenőrzés screen, sending, where the confirmation arrives, uploading it in the app), meghatalmazás 60-100 s. Voice: Gemini 3.8 Flash TTS through OpenRouter (google/gemini-3.8-flash-tts, https://openrouter.ai/api/v1/audio/speech, request shape from D:/Atvitel/Desktop/kukutyini-studio/szinkron_kozos/tts_magyar_gemini.py, key only inside the process from the HKCU Environment registry, never printed). Use the SAME voice as the main video: do the scripts and the picture first, then wait (check every 2 minutes, up to 90 minutes) for ${P}/video/hang.json written by the main-video builder; if it never appears, pick the voice yourself the same way and write that file. Budget: at most 0.30 USD for both videos (log every call to ${P}/video/<name>/koltseg.jsonl, cache takes); you must not top up; on 402 stop the voice part and leave a one-command voice step. Blind-transcription pronunciation check per line, re-take only wrong lines. Outputs per video: <name>.mp4 (H.264 + AAC, <= 15 MB), <name>_poszter.jpg, <name>.vtt, plus copies for the client web export's media folder per SPEC §26. Extract frames every 3 s and LOOK at them.`, 'építés:útmutató-videók'),
  B(`legal + texts ${K}/jogi (drafts for the lawyer, say so): ÁSZF additions (business-registration help as part of the service, what we do and do not do, the client's responsibility for data accuracy), adatkezelési tájékoztató additions (new data categories such as születési adatok, anyja neve, phone calls and call notes, retention), the authorisation template/guide the research recommends for filing the EV bejelentés, the callback consent sentence, updated FAQ and notification texts that the backend serves (coordinate via the content keys in §26). Regenerate any PDFs the app serves from these templates.`, 'építés:jogi'),
])

phase('Összeállítás')
const integ = await agent(`${CTX2}\n\nBUILDERS REPORTED: ${JSON.stringify(built).slice(0, 12000)}\n\nYOUR JOB (integrator): make it all fit and go live. Sync shared contracts, build and test backend, app web export, panel; fix contract mismatches; run the full test suites. Then on appok-1: pg_dump to /srv/kezjegy/_regi/, check Gardoko health, apply the additive migrations, deploy backend + worker + app web + panel (keep previous builds in _regi and keep the previous hashed JS chunks reachable so open tabs do not break), run the idempotent demo-data addition, verify the owner's accounts alex@demo.kezjegy.test and tulaj@demo.kezjegy.test still exist with their onboarding progress intact (query, never print passwords), check Gardoko again. End-to-end on the LOCAL harness: a new client chooses "még nincs vállalkozásom", fills the data, gets the personalised filing guide, uploads a fake confirmation PDF, the team account sees it in the Vállalkozás-indítás pipeline, checks it, enters an adószám, the client continues the normal path (own NAV meghatalmazás with the guide); a stuck client requests a callback and the team works it in the Visszahívások queue; an existing-business client requests a callback from the accountant card; the bottom bar is visible during onboarding, locked features show their reason and the API refuses them before activation, every onboarding item has its Mi ez?/Miért kell?/Hol találod? explainer, and the explainer video plays from https://app.${HOST}/media/bekotes.mp4 and the two guide videos play at the top of their guides (deploy all video files from ${P}/video/bekotes/, ${P}/video/vallalkozas_bejelentes/ and ${P}/video/meghatalmazas/ to the client web origin's /media/). Screenshots ${K}/_qa/k3_*.png - LOOK at each. Update ${P}/STATUS.md briefly (Hungarian) with what changed.`, { label: 'összeállítás:integrátor', phase: 'Összeállítás', schema: DONE })

phase('Célzott ellenőrzés')
const LENS = [
  { k: 'új-vállalkozás', p: `Try to prove order 1 is NOT done well: walk the whole SELF-SERVICE new-business path (order 7: personalised Mit hova jelölj guide, the client files himself, uploads the confirmation, the team only checks; no mandatory call; no ID-card back side) as a client and as the team on the local harness; check every field and every guide step against the official requirements (${JSON.stringify(evKut).slice(0, 4000)}), validation, wording, what the client is promised, the hand-over to the normal path, data protection, and that the live deployment has the same build.` },
  { k: 'visszahívás', p: `Try to prove order 2 is NOT done: search the app, panel, backend texts, notifications, FAQ, legal texts and e-mails for ANY remaining time-slot / appointment / video-call booking or wording that promises the accountant personally for the first call; walk the callback flow both sides (request, claim, failed attempt, retry, done, overdue after 48 h with a faked clock); check the team role cannot do accountant/admin things (API-level).` },
  { k: 'videó-és-magyarázat', p: `Try to prove orders 5, 6 and 8 are NOT done well: for EACH of the three videos (bekotes, vallalkozas_bejelentes, meghatalmazas) - same voice in all three? the guide videos match the guide steps and the official NAV steps? - by extracting frames every 2 s and LOOKING at them (brand fit, nothing cut off, captions readable at phone size, in sync with the audio - compare caption times with a transcription of the audio), transcribe the audio and check every sentence for wrong Hungarian pronunciation, wrong facts versus SPEC §26, names that will change (product, accountant), any mention of AI; check that the video starts with the thank-you, then what the app is good for, then the onboarding steps; check it plays on the onboarding page on the local harness and from the live /media/ URL; read every "Mi ez? / Miért kell? / Hol találod?" explainer for correctness against official sources and for plain wording.` },
  { k: 'alsó-sáv', p: `Try to prove orders 3 and 4 are NOT done: for order 4 call every client API endpoint as a not-yet-activated client on the local harness and list what is allowed vs locked, compare with SPEC §26, and check the UI shows the reason; for order 3 on the local harness at 390x844, 360x780 and 320x640, and in the Android build config, check the bottom bar during every onboarding step and in both branches, what each tab shows before activation, large text, screen reader labels, and that nothing regressed after activation (Kata).` },
]
let checks = await parallel(LENS.map(l => () => agent(`${CTX2}\n\nADVERSARIAL CHECK - ${l.p} Screenshots ${K}/_qa/k3c_${l.k}_*.png, LOOK at them. Report satisfied=false if anything the owner asked for is missing.`, { label: `cél:${l.k}`, phase: 'Célzott ellenőrzés', schema: ISS })))
for (let r = 1; r <= 2; r++) {
  const issues = checks.filter(Boolean).flatMap(c => c.issues)
  const bad = checks.filter(Boolean).some(c => !c.satisfied) || issues.some(i => /blocker|major/i.test(i.severity))
  log(`Célzott ellenőrzés ${r}: ${issues.length} észrevétel${bad ? ', javítás kell' : ', rendben'}`)
  if (!issues.length) break
  await agent(`${CTX2}\n\nFIXER for the owner's 3 orders. Fix all blockers/majors and sensible minors below (dedupe first) across ${K}/backend, ${K}/app, ${K}/panel, ${K}/jogi, run tests, redeploy the same safe way (pg_dump first, additive only, Gardoko health before/after, owner accounts intact), re-screenshot and LOOK. Return a short summary.\n\nISSUES:\n${JSON.stringify(issues).slice(0, 38000)}`, { label: `cél:javítás${r}`, phase: 'Célzott ellenőrzés' })
  if (!bad) break
  checks = await parallel(LENS.map(l => () => agent(`${CTX2}\n\nADVERSARIAL RE-CHECK after fixes (round ${r + 1}) - ${l.p} Screenshots ${K}/_qa/k3c${r + 1}_${l.k}_*.png, LOOK at them.`, { label: `cél${r + 1}:${l.k}`, phase: 'Célzott ellenőrzés', schema: ISS })))
}

log('A 3 tulaj-kérés kész, indul a teljes ellenőrző sorozat (k2)')
const k2 = await workflow({ scriptPath: `${P}/_munka/k2_ellenorzo_korok.js` }, { maxRounds: 5, elozmeny: `Owner orders of 11-18 08:24 were built in k3 (new-business path, callback request instead of booking, bottom bar during onboarding). Integrator: ${JSON.stringify(integ).slice(0, 2500)}` })
return { evKut, spec, built, integ, k2 }
