# /srv/kezjegy/.env – template (SPEC §13). NO VALUES HERE ON PURPOSE.
# The real file is created on the server by deploy/gen-env.sh (random secrets, chmod 600) and changed later
# only with C:/Users/UpgradePC/konyvelo_app/kezjegy_kulcsok.ps1. Never commit, print or copy it anywhere else.
# [OWNER] Keep an offline copy of FILE_ENC_KEY, APP_DATA_KEY, NAV_CRED_KEY and .backup_pass:
# without them the files and backups cannot be read.

# --- mode ---------------------------------------------------------------------------------------
# demo: every integration without keys runs its clearly labelled DEMO adapter.
# production: an integration without keys is switched OFF (503 not_configured) – never fake success.
APP_ENV=demo
NODE_ENV=production
PORT=8080
LOG_LEVEL=info
APP_VERSION=

# --- database (container kezjegy-db, network kezjegy_internal) ------------------------------------
# The API and worker connect as the least-privilege role (deploy/db-roles.sh):
# postgres://kezjegy_app:<KEZJEGY_APP_DB_PASSWORD>@kezjegy-db:5432/kezjegy
DATABASE_URL=
# NOT in this file (QA kör 3): POSTGRES_PASSWORD, MIGRATION_DATABASE_URL and KEZJEGY_APP_DB_PASSWORD live in
# /srv/kezjegy/.env.db (chmod 600), which only kezjegy-db and the one-shot kezjegy-migrate receive.

# --- public addresses (links in e-mails, SimplePay back URL, demo payment page) ------------------
APP_PUBLIC_URL=https://app.45-94-65-74.sslip.io
PANEL_PUBLIC_URL=https://konyvelo.45-94-65-74.sslip.io
API_PUBLIC_URL=https://api.45-94-65-74.sslip.io

# --- secrets (generated: 32 random bytes, base64) ------------------------------------------------
JWT_SECRET=
CODE_HMAC_SECRET=
FILE_LINK_SECRET=
AUDIT_IP_SALT=
# AES-256-GCM keys: exactly 32 bytes (base64 or 64 hex). Three DIFFERENT keys.
FILE_ENC_KEY=
FILE_ENC_KEY_ID=1
APP_DATA_KEY=
NAV_CRED_KEY=

# --- staff 2FA ------------------------------------------------------------------------------------
# true (default): accountants and admins must turn on TOTP at first login. APP_ENV=production refuses
# to start with false; only a DEMO deployment with fake data may set false for trying it out.
STAFF_TOTP_REQUIRED=true

# --- e-mail (Brevo SMTP). Empty SMTP_HOST or MAIL_FROM → DEMO outbox (admin panel) ----------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# e.g. Kézjegy <hello@example.hu>
MAIL_FROM=
MAIL_REPLY_TO=

# --- Google / Apple sign-in. Empty → the button is hidden ----------------------------------------
# comma list in this order: web, android, ios
GOOGLE_CLIENT_IDS=
APPLE_BUNDLE_ID=

# --- SimplePay recurring card payment (HUF) -------------------------------------------------------
# demo | sandbox | live. sandbox/live need the merchant id + secret key from the SimplePay merchant admin.
SIMPLEPAY_MODE=demo
SIMPLEPAY_MERCHANT_HUF=
SIMPLEPAY_SECRET_HUF=
SIMPLEPAY_RECURRING_TIMES=12
SIMPLEPAY_TOKEN_VALID_MONTHS=12
# signs the DEMO payment page only (generated)
SIMPLEPAY_DEMO_SECRET=
PLAN_PRICE_HUF=20000

# --- fee invoices (díjszámla). demo = "DEMO DÍJBEKÉRŐ – NEM SZÁMLA" PDF ----------------------------
INVOICE_MODE=demo
SZAMLAZZHU_AGENT_KEY=
BILLINGO_API_KEY=

# --- NAV Online Számla (READ-ONLY client; the app never files anything to NAV) --------------------
# demo | test | prod. test/prod need the software registration data below.
NAV_MODE=demo
NAV_SOFTWARE_ID=HU00000000KEZJEGY1
NAV_SOFTWARE_VERSION=1.0.0
NAV_DEV_NAME=
NAV_DEV_CONTACT=
NAV_DEV_TAX_NUMBER=
NAV_SYNC_HOUR=5

# --- push (Expo) ----------------------------------------------------------------------------------
PUSH_MODE=demo
EXPO_ACCESS_TOKEN=

# --- proxy ----------------------------------------------------------------------------------------
# client IP = last X-Forwarded-For entry (the shared Caddy sets it)
TRUST_PROXY_HOPS=1

# --- SPEC §26 (owner orders 11-18) ---------------------------------------------------------------
# When a new-business client is charged first: adoszam_utan (default, after the adószám is recorded) | azonnal [OWNER]
NEW_BUSINESS_CHARGE_POLICY=adoszam_utan
# Callback deadline in calendar hours (24 h = amber, this = red/overdue)
CALLBACK_DUE_HOURS=48
# The number we call from, shown to clients ("Erről a számról hívunk: …"); empty = hidden [OWNER]
CALLBACK_CALLER_ID=
