# SPEC §29.3 – every public Adózz host, served by the Adózz proxy (container kezjegy-proxy, compose project
# kezjegy-proxy). Both host sets: adozz.hu (new) and the three sslip.io hosts (kept: the installed APK talks to
# api.45-94-65-74.sslip.io, and web users keep their bookmarks). 45-94-65-74.sslip.io (Gardoko, deleted 11-20) has no
# site block any more. The proxy reaches kezjegy-api / kezjegy-web over the kezjegy_edge network.
# Automatic HTTPS (Let's Encrypt) for every name. Access logs are off on purpose (query strings can hold tokens and
# signed file links). Validate before a reload:
#   docker run --rm --network none -v /srv/kezjegy/proxy/caddy:/etc/caddy:ro caddy:2-alpine caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
# (atallas.sh frissit does exactly this with the NEW folder before it swaps the files)

(kezjegy_fejlecek) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}
}

# Panel and API hosts are not for search engines.
(kezjegy_noindex) {
	header X-Robots-Tag "noindex, nofollow"
}

# CSP only on the static pages (the API answers JSON with Cache-Control: no-store and sets its own CSP on the one
# HTML page it serves, the DEMO payment page). Stripe Checkout is a full redirect: no Stripe origin is needed here.
(kezjegy_csp) {
	header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob: data: https://accounts.google.com; frame-src https://accounts.google.com; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; script-src 'self' https://accounts.google.com/gsi/client; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
}

# Accountant + admin panel: no Google sign-in there, so no Google origins at all.
(kezjegy_csp_panel) {
	header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'none'; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
}

# The landing page adozz.hu: HTML + CSS + ONE own script (js/meres.js) and our own statistics script (/m/script.js) –
# SPEC §31 (2026-11-20): script-src 'self' only, connect-src 'self' (via default-src). No cookie, no third party.
(kezjegy_csp_landing) {
	header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
}

# SPEC §31.6 – PREPARED, NOT USED: the landing CSP for the day ad measurement is switched on (kod/MARKETING.md, step
# "CSP"). Then the adozz.hu block below imports this snippet instead of kezjegy_csp_landing. Allowed, but nothing loads
# them before the visitor's "Elfogadom" (the banner in js/meres.js loads the Meta / Google scripts only after it).
(kezjegy_csp_landing_hirdetes) {
	header Content-Security-Policy "default-src 'self'; img-src 'self' data: https://www.facebook.com https://www.googletagmanager.com https://www.googleadservices.com https://www.google.com https://www.google.hu https://googleads.g.doubleclick.net https://pagead2.googlesyndication.com; style-src 'self'; font-src 'self'; script-src 'self' https://connect.facebook.net https://www.googletagmanager.com https://www.googleadservices.com https://www.google.com; connect-src 'self' https://www.facebook.com https://connect.facebook.net https://www.googletagmanager.com https://www.googleadservices.com https://www.google.com https://googleads.g.doubleclick.net https://ad.doubleclick.net https://pagead2.googlesyndication.com; frame-src https://www.googletagmanager.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
}

# SPEC §31.1 – our own statistics server (Umami 3.5.0, container kezjegy-umami, never public): only the tracker script and
# the collect call pass, under the neutral path /m/; everything else under /m/ (login, UI, API) is 404. No cookie in or
# out. The client address goes in a header of our own (Umami: CLIENT_IP_HEADER), set here from the connection; Umami uses
# it for the daily visitor code (SALT_ROTATION=day) and the local country/city lookup and never stores it. NOTE: this is
# NOT forge-proof – Umami 3.5.0 prefers an "ip" field in the request body over the headers, so a visitor who crafts the
# request can fake his place or split his visits. That only touches the quality of the numbers, never anybody's data.
# The CDN location headers a client may send (cf-ipcountry, x-vercel-ip-*) are ignored (SKIP_LOCATION_HEADERS=1).
# The collect call has short time limits: the landing never waits for it, and a stuck statistics server must not tie up
# the proxy.
(kezjegy_statisztika) {
	@kj_stat_js {
		path /m/script.js
		method GET HEAD
	}
	handle @kj_stat_js {
		rewrite * /script.js
		reverse_proxy kezjegy-umami:3000 {
			header_up -Cookie
			header_up X-Kj-Client-Ip {remote_host}
			header_down -Set-Cookie
		}
	}
	@kj_stat_send {
		path /m/api/send
		method POST
	}
	handle @kj_stat_send {
		request_body {
			max_size 16KB
		}
		rewrite * /api/send
		reverse_proxy kezjegy-umami:3000 {
			header_up -Cookie
			header_up X-Kj-Client-Ip {remote_host}
			header_down -Set-Cookie
			transport http {
				dial_timeout 2s
				response_header_timeout 5s
			}
		}
	}
	# named matchers only: Caddy keeps named handles in this order (a bare path matcher would sort before them)
	@kj_stat_tobbi path /m /m/*
	handle @kj_stat_tobbi {
		respond "Not found" 404
	}
	# SPEC §31.6: the public ends of the (switched-off) ad measurement – same origin for the landing script (the config,
	# the banner's decision, and the check of a stored decision). Switched off the API answers { ads: false } and 404; the
	# landing build has no code that calls them.
	@kj_hirdetes path /api/v1/public/marketing-config /api/v1/public/hozzajarulas /api/v1/public/hozzajarulas/*
	handle @kj_hirdetes {
		request_body {
			max_size 4KB
		}
		reverse_proxy kezjegy-api:8080
	}
}

(kezjegy_api) {
	handle /api/* {
		# Only the multipart upload routes may send up to 60 MB; the one-file routes (message attachments) 26 MB; the
		# Stripe webhook 256 KB; everything else 1 MB (the API checks the same per route while streaming –
		# backend/src/app.ts bodyLimitFor).
		@kezjegy_egy_fajl path_regexp ^/api/v1/(client|acc|team)/attachments/?$
		@kezjegy_feltoltes path_regexp ^/api/v1/(client/(kyc|documents(/[^/]+/versions)?|business-registration/filed)|acc/(clients/[^/]+/documents|documents/[^/]+/versions))/?$
		@kezjegy_nem_feltoltes not path_regexp ^/api/v1/(client/(kyc|attachments|documents(/[^/]+/versions)?|business-registration/filed)|acc/(attachments|clients/[^/]+/documents|documents/[^/]+/versions)|team/attachments)/?$
		@kezjegy_webhook path /api/v1/webhooks/stripe
		request_body @kezjegy_egy_fajl {
			max_size 26MB
		}
		request_body @kezjegy_feltoltes {
			max_size 60MB
		}
		request_body @kezjegy_nem_feltoltes {
			max_size 1MB
		}
		request_body @kezjegy_webhook {
			max_size 256KB
		}
		# Caddy sets X-Forwarded-For to the real client IP (incoming values from untrusted clients are replaced); the
		# API reads the last entry (TRUST_PROXY_HOPS=1).
		reverse_proxy kezjegy-api:8080
	}
}

# ---------- landing ----------
adozz.hu {
	encode zstd gzip
	import kezjegy_fejlecek
	import kezjegy_csp_landing
	import kezjegy_statisztika
	handle {
		reverse_proxy kezjegy-web:8082
	}
}

www.adozz.hu {
	import kezjegy_fejlecek
	redir https://adozz.hu{uri} permanent
}

# ---------- client web app (Expo web export) + same-origin API (first-party refresh cookie, no CORS) ----------
app.adozz.hu, app.45-94-65-74.sslip.io {
	encode zstd gzip
	import kezjegy_fejlecek
	import kezjegy_api
	handle {
		import kezjegy_csp
		reverse_proxy kezjegy-web:8080
	}
}

# ---------- accountant + admin panel (React + Vite) + same-origin API ----------
konyvelo.adozz.hu, konyvelo.45-94-65-74.sslip.io {
	encode zstd gzip
	import kezjegy_fejlecek
	import kezjegy_noindex
	import kezjegy_api
	handle {
		import kezjegy_csp_panel
		reverse_proxy kezjegy-web:8081
	}
}

# ---------- API for the native app, the Stripe webhook, the payment back URLs, the iCal feed (nothing else) ----------
api.adozz.hu, api.45-94-65-74.sslip.io {
	encode zstd gzip
	import kezjegy_fejlecek
	import kezjegy_noindex
	import kezjegy_api
	handle {
		respond "Not found" 404
	}
}
