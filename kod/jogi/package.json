{
  "name": "@kezjegy/jogi",
  "version": "0.1.0",
  "private": true,
  "description": "Jogi szövegek (TERVEZET – jogász ellenőrzi) és a belőlük készülő, ügyféladatokkal kitöltött PDF-ek. SPEC §21.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fonts",
    "index.json",
    "*.md",
    "sablonok",
    "app_szovegek.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "node ../shared/scripts/sync-shared.mjs src/_shared",
    "prebuild": "node ../shared/scripts/sync-shared.mjs src/_shared",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "ellenoriz": "node dist/cli/ellenoriz.js",
    "minta": "node dist/cli/minta.js",
    "app-szovegek": "node dist/cli/app_szovegek_md.js",
    "minden": "npm run build && npm run app-szovegek && npm run ellenoriz && npm test && npm run minta"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
